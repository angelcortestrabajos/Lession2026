// ============================================================
// HEART GRAPH
// ============================================================

@Composable
private fun HeartRateGraph() {

    Canvas(
        modifier = Modifier
            .fillMaxWidth()
            .height(110.dp)
    ) {

        // líneas de referencia

        for (i in 1..3) {

            val y =
                size.height * i / 4f

            drawLine(
                color = PurpleLight,
                start = Offset(
                    0f,
                    y
                ),
                end = Offset(
                    size.width,
                    y
                ),
                strokeWidth = 1.5f
            )
        }

        val points = listOf(
            0.00f to 0.62f,
            0.08f to 0.58f,
            0.16f to 0.72f,
            0.24f to 0.38f,
            0.32f to 0.55f,
            0.40f to 0.20f,
            0.48f to 0.62f,
            0.56f to 0.44f,
            0.64f to 0.68f,
            0.72f to 0.32f,
            0.80f to 0.50f,
            0.88f to 0.25f,
            1.00f to 0.40f
        )

        val path = Path()

        points.forEachIndexed { index, point ->

            val x = size.width * point.first
            val y = size.height * point.second

            if (index == 0) {
                path.moveTo(x, y)
            } else {
                path.lineTo(x, y)
            }
        }

        drawPath(
            path = path,
            color = Neon,
            style = Stroke(
                width = 5f,
                cap = StrokeCap.Round
            )
        )
    }
}


