// ============================================================
// BODY GRAPHIC
// ============================================================

@Composable
private fun BodyGraphic(
    modifier: Modifier
) {

    Canvas(
        modifier = modifier
    ) {

        val cx = size.width / 2f

        // cabeza

        drawCircle(
            color = White,
            radius = 22f,
            center = Offset(
                cx,
                28f
            )
        )

        // cuerpo

        drawRoundRect(
            color = White,
            topLeft = Offset(
                cx - 34f,
                58f
            ),
            size = Size(
                68f,
                95f
            ),
            cornerRadius = androidx.compose.ui.geometry.CornerRadius(
                28f,
                28f
            )
        )

        // brazo izquierdo

        drawRoundRect(
            color = White,
            topLeft = Offset(
                cx - 58f,
                60f
            ),
            size = Size(
                22f,
                90f
            ),
            cornerRadius = androidx.compose.ui.geometry.CornerRadius(
                15f,
                15f
            )
        )

        // brazo derecho

        drawRoundRect(
            color = White,
            topLeft = Offset(
                cx + 36f,
                60f
            ),
            size = Size(
                22f,
                90f
            ),
            cornerRadius = androidx.compose.ui.geometry.CornerRadius(
                15f,
                15f
            )
        )

        // pierna izquierda

        drawRoundRect(
            color = White,
            topLeft = Offset(
                cx - 30f,
                140f
            ),
            size = Size(
                24f,
                80f
            ),
            cornerRadius = androidx.compose.ui.geometry.CornerRadius(
                15f,
                15f
            )
        )

        // pierna derecha

        drawRoundRect(
            color = White,
            topLeft = Offset(
                cx + 6f,
                140f
            ),
            size = Size(
                24f,
                80f
            ),
            cornerRadius = androidx.compose.ui.geometry.CornerRadius(
                15f,
                15f
            )
        )

        // puntos de análisis

        drawCircle(
            color = Red,
            radius = 9f,
            center = Offset(
                cx + 45f,
                93f
            )
        )

        drawCircle(
            color = Yellow,
            radius = 9f,
            center = Offset(
                cx - 17f,
                174f
            )
        )

        drawCircle(
            color = Green,
            radius = 9f,
            center = Offset(
                cx,
                115f
            )
        )
    }
}


// ============================================================
// STATUS
// ============================================================

@Composable
private fun BodyStatus(
    title: String,
    value: String,
    color: Color
) {

    Column {

        Row(
            verticalAlignment = Alignment.CenterVertically
        ) {

            Box(
                modifier = Modifier
                    .size(11.dp)
                    .clip(CircleShape)
                    .background(color)
            )

            Spacer(
                modifier = Modifier.width(9.dp)
            )

            Text(
                text = title,
                color = Gray,
                fontSize = 14.sp
            )
        }

        Spacer(
            modifier = Modifier.height(3.dp)
        )

        Text(
            text = value,
            color = White,
            fontSize = 17.sp,
            fontWeight = FontWeight.Bold
        )
    }
}


// ============================================================
// MÉTRICAS
// ============================================================

@Composable
private fun MetricsGrid() {

    Column {

        Text(
            text = "Datos actuales",
            color = White,
            fontSize = 20.sp,
            fontWeight = FontWeight.Bold
        )

        Spacer(
            modifier = Modifier.height(13.dp)
        )

        Row(
            modifier = Modifier.fillMaxWidth(),
            horizontalArrangement = Arrangement.spacedBy(12.dp)
        ) {

            MetricCard(
                title = "SpO₂",
                value = "97%",
                modifier = Modifier.weight(1f)
            )

            MetricCard(
                title = "Pulso",
                value = "154 BPM",
                modifier = Modifier.weight(1f)
            )
        }

        Spacer(
            modifier = Modifier.height(12.dp)
        )

        Row(
            modifier = Modifier.fillMaxWidth(),
            horizontalArrangement = Arrangement.spacedBy(12.dp)
        ) {

            MetricCard(
                title = "Calorías",
                value = "486 kcal",
                modifier = Modifier.weight(1f)
            )

            MetricCard(
                title = "Actividad",
                value = "72 min",
                modifier = Modifier.weight(1f)
            )
        }
    }
}


@Composable
private fun MetricCard(
    title: String,
    value: String,
    modifier: Modifier
) {

    Box(
        modifier = modifier
            .clip(
                RoundedCornerShape(17.dp)
            )
            .background(PurpleCard)
            .padding(17.dp)
    ) {

        Column {

            Text(
                text = title,
                color = Gray,
                fontSize = 14.sp
            )

            Spacer(
                modifier = Modifier.height(6.dp)
            )

            Text(
                text = value,
                color = Neon,
                fontSize = 19.sp,
                fontWeight = FontWeight.Bold
            )
        }
    }
}


// ============================================================
// MENU
// ============================================================

@Composable
private fun MenuScreen(
    nombre: String,
    avatarUri: Uri?,
    onHome: () -> Unit,
    onProfile: () -> Unit,
    onConfiguration: () -> Unit,
    onBack: () -> Unit
) {

    BaseScreen {

        Column(
            modifier = Modifier.fillMaxSize()
        ) {

            Row(
                modifier = Modifier
                    .fillMaxWidth()
                    .height(72.dp)
                    .background(Purple)
                    .padding(horizontal = 18.dp),
                verticalAlignment = Alignment.CenterVertically
            ) {

                LessionLogo(
                    modifier = Modifier.width(145.dp)
                )

                Spacer(
                    modifier = Modifier.weight(1f)
                )

                IconButton(
                    onClick = onBack
                ) {

                    Icon(
                        imageVector = Icons.AutoMirrored.Filled.ArrowBack,
                        contentDescription = "Cerrar",
                        tint = White
                    )
                }
            }

            Column(
                modifier = Modifier
                    .fillMaxWidth()
                    .padding(22.dp)
            ) {

                Text(
                    text = "Menú",
                    color = White,
                    fontSize = 32.sp,
                    fontWeight = FontWeight.Bold
                )

                Spacer(
                    modifier = Modifier.height(25.dp)
                )

                if (avatarUri != null) {

                    AsyncImage(
                        model = avatarUri,
                        contentDescription = null,
                        modifier = Modifier
                            .size(70.dp)
                            .clip(CircleShape),
                        contentScale = ContentScale.Crop
                    )
                }

                if (nombre.isNotBlank()) {

                    Spacer(
                        modifier = Modifier.height(10.dp)
                    )

                    Text(
                        text = nombre,
                        color = White,
                        fontSize = 19.sp,
                        fontWeight = FontWeight.Bold
                    )
                }

                Spacer(
                    modifier = Modifier.height(25.dp)
                )

                MenuOption(
                    text = "Inicio",
                    onClick = onHome
                )

                MenuOption(
                    text = "Perfil",
                    onClick = onProfile
                )

                MenuOption(
                    text = "Configuración",
                    onClick = onConfiguration
                )

                MenuOption(
                    text = "Sobre nosotros",
                    onClick = onConfiguration
                )

                MenuOption(
                    text = "+ Info",
                    onClick = onConfiguration
                )
            }
        }
    }
}


// ============================================================
// PERFIL
// ============================================================

@Composable
private fun ProfileScreen(

    nombre: String,
    fechaNacimiento: String,
    peso: String,
    altura: String,
    sexo: String,
    tipoCuerpo: String,
    deporte: String,
    horasActividad: String,
    avatarUri: Uri?,

    onAvatarChange: (Uri) -> Unit,
    onNombreChange: (String) -> Unit,
    onFechaChange: (String) -> Unit,
    onPesoChange: (String) -> Unit,
    onAlturaChange: (String) -> Unit,
    onSexoChange: (String) -> Unit,
    onTipoCuerpoChange: (String) -> Unit,
    onDeporteChange: (String) -> Unit,
    onHorasChange: (String) -> Unit,

    onSave: () -> Unit,
    onMenu: () -> Unit
) {

    val launcher =
        rememberLauncherForActivityResult(
            ActivityResultContracts.GetContent()
        ) { uri ->

            if (uri != null) {
                onAvatarChange(uri)
            }
        }

    BaseScreen {

        Column(
            modifier = Modifier
                .fillMaxSize()
                .verticalScroll(
                    rememberScrollState()
                )
                .padding(
                    horizontal = 24.dp,
                    vertical = 15.dp
                )
        ) {

            Row(
                modifier = Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.SpaceBetween
            ) {

                LessionLogo(
                    modifier = Modifier.width(145.dp)
                )

                IconButton(
                    onClick = onMenu
                ) {

                    Icon(
                        imageVector = Icons.Default.Menu,
                        contentDescription = "Menú",
                        tint = White
                    )
                }
            }

            Spacer(
                modifier = Modifier.height(15.dp)
            )

            Text(
                text = "Mi perfil",
                color = White,
                fontSize = 30.sp,
                fontWeight = FontWeight.Bold
            )

            Spacer(
                modifier = Modifier.height(20.dp)
            )

            AvatarSelector(
                avatarUri = avatarUri,
                onClick = {
                    launcher.launch("image/*")
                }
            )

            Spacer(
                modifier = Modifier.height(12.dp)
            )

            Text(
                text = "Cambiar avatar",
                color = Neon,
                fontSize = 16.sp,
                fontWeight = FontWeight.Bold,
                modifier = Modifier.align(Alignment.CenterHorizontally)
            )

            Spacer(
                modifier = Modifier.height(25.dp)
            )

            BigTextField(
                value = nombre,
                onValueChange = onNombreChange,
                placeholder = "Nombre"
            )

            Spacer(Modifier.height(13.dp))

            BigTextField(
                value = fechaNacimiento,
                onValueChange = onFechaChange,
                placeholder = "Fecha de nacimiento"
            )

            Spacer(Modifier.height(13.dp))

            Row(
                modifier = Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.spacedBy(12.dp)
            ) {

                BigTextField(
                    value = peso,
                    onValueChange = onPesoChange,
                    placeholder = "Peso",
                    modifier = Modifier.weight(1f)
                )

                BigTextField(
                    value = altura,
                    onValueChange = onAlturaChange,
                    placeholder = "Altura",
                    modifier = Modifier.weight(1f)
                )
            }

            Spacer(Modifier.height(13.dp))

            Row(
                modifier = Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.spacedBy(12.dp)
            ) {

                BigTextField(
                    value = sexo,
                    onValueChange = onSexoChange,
                    placeholder = "Sexo",
                    modifier = Modifier.weight(1f)
                )

                BigTextField(
                    value = tipoCuerpo,
                    onValueChange = onTipoCuerpoChange,
                    placeholder = "Tipo de cuerpo",
                    modifier = Modifier.weight(1f)
                )
            }

            Spacer(
                modifier = Modifier.height(25.dp)
            )

            Text(
                text = "Opcionales",
                color = White,
                fontSize = 18.sp,
                fontWeight = FontWeight.Bold
            )

            Spacer(
                modifier = Modifier.height(12.dp)
            )

            BigTextField(
                value = deporte,
                onValueChange = onDeporteChange,
                placeholder = "Deporte que realizas"
            )

            Spacer(
                modifier = Modifier.height(13.dp)
            )

            BigTextField(
                value = horasActividad,
                onValueChange = onHorasChange,
                placeholder = "Horas semanales de actividad"
            )

            Spacer(
                modifier = Modifier.height(25.dp)
            )

            PrimaryButton(
                text = "GUARDAR CAMBIOS",
                modifier = Modifier.fillMaxWidth(),
                onClick = onSave
            )

            Spacer(
                modifier = Modifier.height(25.dp)
            )
        }
    }
}


// ============================================================
// LOGIN
// ============================================================

@Composable
private fun LoginScreen(
    onLogin: () -> Unit,
    onBack: () -> Unit
) {

    var email by remember {
        mutableStateOf("")
    }

    var password by remember {
        mutableStateOf("")
    }

    var showPassword by remember {
        mutableStateOf(false)
    }

    BaseScreen {

        Column(
            modifier = Modifier
                .fillMaxSize()
                .padding(25.dp)
        ) {

            IconButton(
                onClick = onBack
            ) {

                Icon(
                    imageVector = Icons.AutoMirrored.Filled.ArrowBack,
                    contentDescription = null,
                    tint = White
                )
            }

            Spacer(
                modifier = Modifier.height(30.dp)
            )

            LessionLogo(
                modifier = Modifier.fillMaxWidth()
            )

            Spacer(
                modifier = Modifier.height(40.dp)
            )

            Text(
                text = "Iniciar sesión",
                color = White,
                fontSize = 30.sp,
                fontWeight = FontWeight.Bold
            )

            Spacer(
                modifier = Modifier.height(25.dp)
            )

            BigTextField(
                value = email,
                onValueChange = {
                    email = it
                },
                placeholder = "Usuario o email"
            )

            Spacer(
                modifier = Modifier.height(15.dp)
            )

            BigTextField(
                value = password,
                onValueChange = {
                    password = it
                },
                placeholder = "Contraseña",

                visualTransformation =
                    if (showPassword)
                        VisualTransformation.None
                    else
                        PasswordVisualTransformation(),

                trailingIcon = {

                    IconButton(
                        onClick = {
                            showPassword = !showPassword
                        }
                    ) {

                        Icon(
                            imageVector =
                                if (showPassword)
                                    Icons.Default.VisibilityOff
                                else
                                    Icons.Default.Visibility,

                            contentDescription = null,
                            tint = White
                        )
                    }
                }
            )

            Spacer(
                modifier = Modifier.height(25.dp)
            )

            PrimaryButton(
                text = "LOGIN",
                modifier = Modifier.fillMaxWidth(),
                onClick = onLogin
            )
        }
    }
}


// ============================================================
// LOGO REAL
// ============================================================

@Composable
private fun LessionLogo(
    modifier: Modifier
) {

    Row(
        modifier = modifier,
        verticalAlignment = Alignment.CenterVertically
    ) {

        Text(
            text = "LESSION",
            color = Neon,
            fontSize = 24.sp,
            fontWeight = FontWeight.Black,
            modifier = Modifier.padding(horizontal = 8.dp)
        )
    }
}


// ============================================================
// BASE
// ============================================================

@Composable
private fun BaseScreen(
    content: @Composable BoxScope.() -> Unit
) {

    Box(
        modifier = Modifier
            .fillMaxSize()
            .background(Background)
    ) {

        // línea superior característica
        Box(
            modifier = Modifier
                .fillMaxWidth()
                .height(5.dp)
                .background(Neon)
                .align(Alignment.TopCenter)
        )

        content()
    }
}


// ============================================================
// TEXT FIELD
// ============================================================

@Composable
private fun BigTextField(

    value: String,
    onValueChange: (String) -> Unit,
    placeholder: String,

    modifier: Modifier =
        Modifier.fillMaxWidth(),

    visualTransformation: VisualTransformation =
        VisualTransformation.None,

    trailingIcon:
    @Composable (() -> Unit)? = null
) {

    OutlinedTextField(

        value = value,

        onValueChange = onValueChange,

        modifier = modifier.height(59.dp),

        singleLine = true,

        placeholder = {

            Text(
                text = placeholder,
                color = Gray,
                fontSize = 16.sp
            )
        },

        textStyle = LocalTextStyle.current.copy(
            color = White,
            fontSize = 17.sp
        ),

        visualTransformation =
            visualTransformation,

        trailingIcon =
            trailingIcon,

        colors =
            OutlinedTextFieldDefaults.colors(

                focusedContainerColor =
                    PurpleCard,

                unfocusedContainerColor =
                    PurpleCard,

                focusedBorderColor =
                    PurpleLight,

                unfocusedBorderColor =
                    PurpleLight,

                focusedTextColor =
                    White,

                unfocusedTextColor =
                    White,

                cursorColor =
                    Neon
            ),

        shape =
            RoundedCornerShape(18.dp)
    )
}


// ============================================================
// BUTTON
// ============================================================

@Composable
private fun PrimaryButton(

    text: String,

    modifier: Modifier,

    onClick: () -> Unit
) {

    Button(

        onClick = onClick,

        modifier =
            modifier.height(57.dp),

        shape =
            RoundedCornerShape(30.dp),

        colors =
            ButtonDefaults.buttonColors(
                containerColor = PurpleLight
            )
    ) {

        Text(
            text = text,
            color = White,
            fontSize = 17.sp,
            fontWeight = FontWeight.Bold
        )
    }
}


// ============================================================
// CARD
// ============================================================

@Composable
private fun CardContainer(
    content: @Composable ColumnScope.() -> Unit
) {

    Column(

        modifier = Modifier
            .fillMaxWidth()
            .clip(
                RoundedCornerShape(21.dp)
            )
            .background(PurpleCard)
            .padding(20.dp),

        content = content
    )
}


// ============================================================
// MENU OPTION
// ============================================================

@Composable
private fun MenuOption(
    text: String,
    onClick: () -> Unit
) {

    Box(

        modifier = Modifier
            .fillMaxWidth()
            .height(62.dp)
            .padding(vertical = 4.dp)
            .clip(
                RoundedCornerShape(17.dp)
            )
            .background(PurpleCard)
            .clickable {
                onClick()
            }
            .padding(horizontal = 20.dp),

        contentAlignment = Alignment.CenterStart
    ) {

        Text(
            text = text,
            color = White,
            fontSize = 18.sp,
            fontWeight = FontWeight.Medium
        )
    }
}

