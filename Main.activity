@Composable
private fun ConnectionLine(
    icon: ImageVector,
    title: String,
    enabled: Boolean,
    onChange: (Boolean) -> Unit
) {

    Row(
        Modifier
            .fillMaxWidth()
            .padding(
                vertical = 5.dp
            ),

        verticalAlignment =
            Alignment.CenterVertically
    ) {

        Icon(
            imageVector = icon,
            contentDescription = null,

            tint =
                if (enabled)
                    Amarillo
                else
                    Blanco,

            modifier = Modifier.size(27.dp)
        )

        Spacer(
            Modifier.width(8.dp)
        )

        Text(
            text = title,
            color = Blanco,
            fontSize = 15.sp,

            modifier = Modifier.weight(1f)
        )

        Switch(
            checked = enabled,
            onCheckedChange = onChange
        )
    }
}

