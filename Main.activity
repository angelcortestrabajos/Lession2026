import androidx.compose.ui.text.input.PasswordVisualTransformation
import androidx.compose.ui.text.input.VisualTransformation
import androidx.compose.ui.unit.dp
import androidx.compose.ui.unit.sp
import androidx.core.view.WindowCompat
import androidx.core.view.WindowInsetsCompat
import androidx.core.view.WindowInsetsControllerCompat

private val Fondo = Color(0xFF24136F)
private val Morado = Color(0xFF351F96)
private val MoradoClaro = Color(0xFF4630C7)
private val Amarillo = Color(0xFFEFFF00)
private val Blanco = Color.White
private val Gris = Color(0xFFD7D7DF)
private val Cian = Color(0xFF00CFFF)
private val Rojo = Color(0xFFEF3039)
private val Naranja = Color(0xFFFF8A00)

private enum class Screen {
    WELCOME,
    LOGIN,
    SIGNIN,
    PROFILE,
    DASHBOARD,
    MENU
}

data class ProfileData(
    val name: String = "",
    val birthDate: String = "",
    val weight: String = "",
    val height: String = "",
    val gender: String = "",
    val bodyType: String = "",
    val sport: String = "",
    val weeklyHours: String = "",
    val avatar: String = ""
)

class MainActivity : ComponentActivity() {

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        enableEdgeToEdge()

        WindowCompat.setDecorFitsSystemWindows(
            window,
            false
        )

        WindowInsetsControllerCompat(
            window,
            window.decorView
        ).apply {

            hide(WindowInsetsCompat.Type.statusBars())
            hide(WindowInsetsCompat.Type.navigationBars())

            systemBarsBehavior =
                WindowInsetsControllerCompat
                    .BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE
        }

        setContent {
            LessionApp()
        }
    }
}

@Composable
private fun LessionApp() {
    val context = LocalContext.current

    var screen by remember {
        mutableStateOf(Screen.WELCOME)
    }

    var profile by remember {
        mutableStateOf(loadProfile(context))
    }

    when (screen) {

        Screen.WELCOME -> {

            WelcomeScreen(
                onLogin = {
                    screen = Screen.LOGIN
                },
                onSignIn = {
                    screen = Screen.SIGNIN
                }
            )
        }

        Screen.LOGIN -> {

            LoginScreen(
                onBack = {
                    screen = Screen.WELCOME
                },
                onSuccess = {
                    profile = loadProfile(context)
                    screen = Screen.PROFILE
                }
            )
        }

        Screen.SIGNIN -> {

            SignInScreen(
                onBack = {
                    screen = Screen.WELCOME
                },
                onCreated = {
                    profile = it
                    screen = Screen.PROFILE
                }
            )
        }

        Screen.PROFILE -> {

            ProfileScreen(
                profile = profile,

                onProfileChanged = {
                    profile = it
                },

                onContinue = {
                    saveProfile(context, profile)
                    screen = Screen.DASHBOARD
                },

                onMenu = {
                    screen = Screen.MENU
                },

                onLogout = {
                    screen = Screen.WELCOME
                }
            )
        }

        Screen.DASHBOARD -> {

            DashboardScreen(
                onMenu = {
                    screen = Screen.MENU
                }
            )
        }

        Screen.MENU -> {

            MenuScreen(
                onHome = {
                    screen = Screen.DASHBOARD
                },
                onProfile = {
                    screen = Screen.PROFILE
                },
                onLogout = {
                    screen = Screen.WELCOME
                }
            )
        }
    }
}

