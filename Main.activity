// ============================================================
// SETTINGS DROPDOWN
// ============================================================

@Composable
private fun SettingsDropdown(
    title: String,
    value: String,
    options: List<String>,
    onSelected: (String) -> Unit
) {

    var expanded by remember {
        mutableStateOf(false)
    }

    Row(
        Modifier
            .fillMaxWidth()
            .clickable {
                expanded = true
            }
            .padding(
                vertical = 9.dp
            ),

        verticalAlignment =
            Alignment.CenterVertically
    ) {

        Text(
            text = title,
            color = Blanco,
            fontSize = 15.sp,

            modifier = Modifier.weight(1f)
        )

        Text(
            text = value,
            color = Amarillo,
            fontSize = 14.sp
        )

        Icon(
            imageVector = Icons.Default.ArrowDropDown,
            contentDescription = null,
            tint = Blanco
        )

        DropdownMenu(
            expanded = expanded,

            onDismissRequest = {
                expanded = false
            },

            modifier =
                Modifier.background(
                    Morado
                )
        ) {

            options.forEach { option ->

                DropdownMenuItem(

                    text = {

                        Text(
                            text = option,
                            color = Blanco,
                            fontSize = 16.sp
                        )
                    },

                    onClick = {

                        onSelected(
                            option
                        )

                        expanded = false
                    }
                )
            }
        }
    }
}

// ============================================================
// PERFIL STORAGE
// ============================================================

private fun saveProfile(
    preferences:
    android.content.SharedPreferences,

    profile: ProfileData
) {

    preferences.edit {

        putString(
            "profile_name",
            profile.name
        )

        putString(
            "profile_birthDate",
            profile.birthDate
        )

        putString(
            "profile_weight",
            profile.weight
        )

        putString(
            "profile_height",
            profile.height
        )

        putString(
            "profile_gender",
            profile.gender
        )

        putString(
            "profile_bodyType",
            profile.bodyType
        )

        putString(
            "profile_sport",
            profile.sport
        )

        putString(
            "profile_weeklyHours",
            profile.weeklyHours
        )

        putString(
            "profile_avatar",
            profile.avatar
        )
    }
}

// ============================================================
// LOAD PROFILE
// ============================================================

private fun loadProfile(
    preferences:
    android.content.SharedPreferences
): ProfileData {

    return ProfileData(

        name =
            preferences.getString(
                "profile_name",
                ""
            ) ?: "",

        birthDate =
            preferences.getString(
                "profile_birthDate",
                ""
            ) ?: "",

        weight =
            preferences.getString(
                "profile_weight",
                ""
            ) ?: "",

        height =
            preferences.getString(
                "profile_height",
                ""
            ) ?: "",

        gender =
            preferences.getString(
                "profile_gender",
                ""
            ) ?: "",

        bodyType =
            preferences.getString(
                "profile_bodyType",
                ""
            ) ?: "",

        sport =
            preferences.getString(
                "profile_sport",
                ""
            ) ?: "",

        weeklyHours =
            preferences.getString(
                "profile_weeklyHours",
                ""
            ) ?: "",

        avatar =
            preferences.getString(
                "profile_avatar",
                ""
            ) ?: ""
    )
}

// ============================================================
// FUNCIÓN AUXILIAR
// ============================================================

private fun languageForMessage(
    t: AppStrings
): Boolean {

    return t.login != "Log In"
}

