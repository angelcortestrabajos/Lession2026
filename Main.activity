                text = "Sign In",
                onClick = onSignIn
            )
        }
    }
}

/* ============================================================
   LOGIN
   ============================================================ */

@Composable
private fun LoginScreen(
    onBack: () -> Unit,
    onSuccess: (String) -> Unit
) {

    val context = LocalContext.current

    val preferences = remember {
        context.getSharedPreferences(
            "lession",
            Context.MODE_PRIVATE
        )
    }

    var username by remember {
        mutableStateOf(
            preferences.getString(
                "username",
                ""
            ) ?: ""
        )
    }

    var password by remember {
        mutableStateOf(
            if (
                preferences.getBoolean(
                    "savePassword",
                    false
                )
            ) {
                preferences.getString(
                    "password",
                    ""
                ) ?: ""
            } else {
                ""
            }
        )
    }

    var savePassword by remember {
        mutableStateOf(
            preferences.getBoolean(
                "savePassword",
                false
            )
        )
    }

    var showPassword by remember {
        mutableStateOf(false)
    }

    Box(
        modifier = Modifier
            .fillMaxSize()
            .background(Fondo)
    ) {

        LazyColumn(
            modifier = Modifier
                .fillMaxSize()
                .padding(horizontal = 35.dp),
            horizontalAlignment = Alignment.CenterHorizontally
        ) {

            item {

                Spacer(
                    modifier = Modifier.height(30.dp)
                )

                LessionLogo(
                    modifier = Modifier.size(145.dp)
                )

                Spacer(
                    modifier = Modifier.height(10.dp)
                )

                Text(
                    text = "LESSION",
                    color = Amarillo,
                    fontSize = 29.sp,
                    fontWeight = FontWeight.ExtraBold
                )

                Spacer(
                    modifier = Modifier.height(30.dp)
                )

                LessionField(
                    value = username,
                    onValueChange = {
                        username = it
                    },
                    hint = "Username or email"
                )

                Spacer(
                    modifier = Modifier.height(14.dp)
                )

                Box {

                    LessionField(
                        value = password,
                        onValueChange = {
                            password = it
                        },
                        hint = "Password",
                        password = !showPassword
                    )

                    IconButton(
                        onClick = {
                            showPassword = !showPassword
                        },
                        modifier = Modifier
                            .align(Alignment.CenterEnd)
                    ) {

                        Icon(
                            imageVector =
                                if (showPassword)
                                    Icons.Default.Visibility
                                else
                                    Icons.Default.VisibilityOff,
                            contentDescription = null,
                            tint = Gris
                        )
                    }
                }

                Spacer(
                    modifier = Modifier.height(8.dp)
                )

                Row(
                    modifier = Modifier.fillMaxWidth(),
                    verticalAlignment =
                        Alignment.CenterVertically
                ) {

                    Checkbox(
                        checked = savePassword,
                        onCheckedChange = {
                            savePassword = it
                        },
                        colors = CheckboxDefaults.colors(
                            checkedColor = Amarillo,
                            checkmarkColor = Fondo
                        )
                    )

                    Text(
                        text = "Guardar contraseña",
                        color = Blanco,
                        fontSize = 15.sp
                    )
                }

                Spacer(
                    modifier = Modifier.height(15.dp)
                )

                SmallPurpleButton(
                    text = "LOGIN",
                    onClick = {

                        val savedUser =
                            preferences.getString(
                                "username",
                                null
                            )

                        val savedPassword =
                            preferences.getString(
                                "password",
                                null
                            )

                        if (
                            username.isBlank() ||
                            password.isBlank()
                        ) {

                            Toast.makeText(
                                context,
                                "Completa todos los campos",
                                Toast.LENGTH_SHORT
                            ).show()

                            return@SmallPurpleButton
                        }

                        if (
                            savedUser == null ||
                            savedPassword == null
                        ) {

                            Toast.makeText(
                                context,
                                "Primero debes crear una cuenta",
                                Toast.LENGTH_SHORT
                            ).show()

                            return@SmallPurpleButton
                        }

                        if (
                            username != savedUser ||
                            password != savedPassword
                        ) {

                            Toast.makeText(
                                context,
                                "Usuario o contraseña incorrectos",
                                Toast.LENGTH_SHORT
                            ).show()

                            return@SmallPurpleButton
                        }

                        preferences.edit()
                            .putBoolean(
                                "savePassword",
                                savePassword
                            )
                            .apply()

                        onSuccess(username)
                    }
                )

                Spacer(
                    modifier = Modifier.height(15.dp)
                )

                TextButton(
                    onClick = onBack
                ) {

                    Text(
                        text = "Volver",
                        color = Amarillo,
                        fontSize = 16.sp
                    )
                }
            }
        }
    }
}

/* ============================================================
   SIGN IN
   ============================================================ */

@Composable
private fun SignInScreen(
    onBack: () -> Unit,
    onCreated: (ProfileData) -> Unit
) {

    val context = LocalContext.current

    var username by remember {
        mutableStateOf("")
    }

    var password by remember {
        mutableStateOf("")
    }

    var confirmPassword by remember {
        mutableStateOf("")
    }

    var name by remember {
        mutableStateOf("")
    }

    var birthDate by remember {
        mutableStateOf("")
    }

    var weight by remember {
        mutableStateOf("")
    }

    var height by remember {
        mutableStateOf("")
    }

    var gender by remember {
        mutableStateOf("")
    }

    var bodyType by remember {
        mutableStateOf("")
    }

    var sport by remember {
        mutableStateOf("")
    }

    var weeklyHours by remember {
        mutableStateOf("")
    }

    LazyColumn(
        modifier = Modifier
            .fillMaxSize()
            .background(Fondo)
            .padding(horizontal = 28.dp)
    ) {

        item {

            Spacer(
                modifier = Modifier.height(18.dp)
            )

            LessionLogo(
                modifier = Modifier
                    .fillMaxWidth()
                    .height(100.dp)
            )

            Text(
                text = "Configura tu perfil",
                modifier = Modifier.fillMaxWidth(),
                color = Blanco,
                fontSize = 23.sp,
                fontWeight = FontWeight.Bold
            )

            Spacer(
                modifier = Modifier.height(20.dp)
            )

            /* ACCESO */

            LessionField(
                value = username,
                onValueChange = {
                    username = it
                },
                hint = "Username or email"
            )

            Spacer(
                modifier = Modifier.height(10.dp)
            )

            LessionField(
                value = password,
                onValueChange = {
                    password = it
                },
                hint = "Password",
                password = true
            )

            Spacer(
                modifier = Modifier.height(10.dp)
            )

            LessionField(
                value = confirmPassword,
                onValueChange = {
                    confirmPassword = it
                },
                hint = "Confirmar contraseña",
                password = true
            )

            Spacer(
                modifier = Modifier.height(20.dp)
            )

            /* PERFIL */

            ProfileHeader()

            Spacer(
                modifier = Modifier.height(15.dp)
            )

            LessionField(
                value = name,
                onValueChange = {
                    name = it
                },
                hint = "Nombre"
            )

            Spacer(
                modifier = Modifier.height(9.dp)
            )

            LessionField(
                value = birthDate,
                onValueChange = {
                    birthDate = it
                },
                hint = "Fecha de nacimiento"
            )

            Spacer(
                modifier = Modifier.height(9.dp)
            )

            Row(
                horizontalArrangement =
                    Arrangement.spacedBy(8.dp)
            ) {

                LessionField(
                    value = weight,
                    onValueChange = {
                        weight = it
                    },
                    hint = "Peso",
                    modifier = Modifier.weight(1f)
                )

                LessionField(
                    value = height,
                    onValueChange = {
                        height = it
                    },
                    hint = "Altura",
                    modifier = Modifier.weight(1f)
                )
            }

            Spacer(
                modifier = Modifier.height(9.dp)
            )

            DropdownField(
                value = gender,
                hint = "Género",
                options = listOf(
                    "Masculino",
                    "Femenino",
                    "Prefiero no decirlo"
                ),
                onSelected = {
                    gender = it
                }
            )

            Spacer(
                modifier = Modifier.height(9.dp)
            )

            DropdownField(
                value = bodyType,
                hint = "Tipo de cuerpo",
                options = listOf(
                    "Hectomorfo",
                    "Endomorfo",
                    "Mesomorfo"
                ),
                onSelected = {
                    bodyType = it
                }
            )

            Spacer(
                modifier = Modifier.height(9.dp)
            )

            Text(
                text = "Opcionales",
                color = Gris,
                fontSize = 14.sp
            )

            Spacer(
                modifier = Modifier.height(5.dp)
            )

            LessionField(
                value = sport,
                onValueChange = {
                    sport = it
                },
                hint = "Deporte que realizas"
            )

            Spacer(
                modifier = Modifier.height(9.dp)
            )

            LessionField(
                value = weeklyHours,
                onValueChange = {
                    weeklyHours = it
                },
                hint = "Horas semanales de actividad"
            )

            Spacer(
                modifier = Modifier.height(20.dp)
            )

            SmallPurpleButton(
                text = "SAVE",
                onClick = {

                    if (
                        username.isBlank() ||
                        password.isBlank() ||
                        confirmPassword.isBlank() ||
                        name.isBlank() ||
                        birthDate.isBlank() ||
                        weight.isBlank() ||
                        height.isBlank() ||
                        gender.isBlank() ||
                        bodyType.isBlank() ||
                        sport.isBlank() ||
                        weeklyHours.isBlank()
                    ) {

                        Toast.makeText(
                            context,
                            "Completa todos los campos",
                            Toast.LENGTH_SHORT
                        ).show()

                        return@SmallPurpleButton
                    }

                    if (password != confirmPassword) {

                        Toast.makeText(
                            context,
                            "Las contraseñas no coinciden",
                            Toast.LENGTH_SHORT
                        ).show()

                        return@SmallPurpleButton
                    }

                    if (password.length < 6) {

                        Toast.makeText(
                            context,
                            "La contraseña debe tener mínimo 6 caracteres",
                            Toast.LENGTH_SHORT
                        ).show()

                        return@SmallPurpleButton
                    }

                    context
                        .getSharedPreferences(
                            "lession",
                            Context.MODE_PRIVATE
                        )
                        .edit()
                        .putString(
                            "username",
                            username
                        )
                        .putString(
                            "password",
                            password
                        )
                        .apply()

                    val newProfile = ProfileData(
                        name = name,
                        birthDate = birthDate,
                        weight = weight,
                        height = height,
                        gender = gender,
                        bodyType = bodyType,
                        sport = sport,
                        weeklyHours = weeklyHours
                    )

                    saveProfile(context, newProfile)

                    onCreated(newProfile)
                }
            )

            Spacer(
                modifier = Modifier.height(12.dp)
            )

            TextButton(
                onClick = onBack
            ) {

                Text(
                    text = "Volver",
                    color = Amarillo,
                    fontSize = 16.sp
                )
            }

            Spacer(
                modifier = Modifier.height(35.dp)
            )
        }
    }
}

/* ============================================================
   PROFILE
   ============================================================ */

@Composable
private fun ProfileScreen(
    profile: ProfileData,
    onProfileChanged: (ProfileData) -> Unit,
    onContinue: () -> Unit,
    onMenu: () -> Unit,
    onLogout: () -> Unit
) {

    var gender by remember(profile.gender) {
        mutableStateOf(profile.gender)
    }

    var bodyType by remember(profile.bodyType) {
        mutableStateOf(profile.bodyType)
    }

    var avatar by remember(profile.avatar) {
        mutableStateOf(profile.avatar)
    }

    val avatarPicker =
        rememberLauncherForActivityResult(
            ActivityResultContracts.GetContent()
        ) { uri: Uri? ->

            if (uri != null) {
                avatar = uri.toString()

                onProfileChanged(
                    profile.copy(
                        avatar = uri.toString()
                    )
                )
            }
        }

    Column(
        modifier = Modifier
            .fillMaxSize()
            .background(Fondo)
    ) {

        TopBar(
            onMenu = onMenu
        )

        LazyColumn(
            modifier = Modifier
                .fillMaxSize()
                .padding(horizontal = 25.dp)
        ) {

            item {

                Spacer(
                    modifier = Modifier.height(18.dp)
                )

                ProfileHeader(
                    avatar = avatar,
                    onAvatarClick = {
                        avatarPicker.launch("image/*")
                    }
                )

                Spacer(
                    modifier = Modifier.height(18.dp)
                )

                /* CAMPOS */

                ProfileReadOnly(
                    "Nombre",
                    profile.name
                )

                ProfileReadOnly(
                    "Fecha de nacimiento",
                    profile.birthDate
                )

                ProfileReadOnly(
                    "Peso",
                    profile.weight
                )

                ProfileReadOnly(
                    "Altura",
                    profile.height
                )

                Spacer(
                    modifier = Modifier.height(8.dp)
                )

                DropdownField(
                    value = gender,
                    hint = "Género",
                    options = listOf(
                        "Masculino",
                        "Femenino",
                        "Prefiero no decirlo"
                    ),
                    onSelected = {
                        gender = it

                        onProfileChanged(
                            profile.copy(
                                gender = it
                            )
                        )
                    }
                )

                Spacer(
                    modifier = Modifier.height(9.dp)
                )

                DropdownField(
                    value = bodyType,
                    hint = "Tipo de cuerpo",
                    options = listOf(
                        "Hectomorfo",
                        "Endomorfo",
                        "Mesomorfo"
                    ),
                    onSelected = {
                        bodyType = it

                        onProfileChanged(
                            profile.copy(
                                bodyType = it
                            )
                        )
                    }
                )

                Spacer(
                    modifier = Modifier.height(10.dp)
                )

                ProfileReadOnly(
                    "Deporte que realizas",
                    profile.sport
                )

                ProfileReadOnly(
                    "Horas semanales de actividad",
                    profile.weeklyHours
                )

                Spacer(
                    modifier = Modifier.height(20.dp)
                )

                SmallPurpleButton(
                    text = "SAVE",
                    onClick = {

                        onProfileChanged(
                            profile.copy(
                                gender = gender,
                                bodyType = bodyType,
                                avatar = avatar
                            )
                        )

                        onContinue()
                    }
                )

                Spacer(
                    modifier = Modifier.height(13.dp)
                )

                OutlinedButton(
                    onClick = onLogout,
                    modifier = Modifier
                        .fillMaxWidth()
                        .height(48.dp),
                    colors = ButtonDefaults.outlinedButtonColors(
                        contentColor = Rojo
                    ),
                    border = ButtonDefaults.outlinedButtonBorder(true)
                ) {

                    Icon(
                        Icons.Default.PowerSettingsNew,
                        contentDescription = null,
                        tint = Rojo
                    )

                    Spacer(
                        modifier = Modifier.width(7.dp)
                    )

                    Text(
                        "Cerrar sesión",
                        color = Rojo,
                        fontSize = 16.sp
                    )
                }

                Spacer(
                    modifier = Modifier.height(30.dp)
                )
            }
        }
    }
}

/* ============================================================
   DASHBOARD
   ============================================================ */

@Composable
private fun DashboardScreen(
    onMenu: () -> Unit
) {

    var bluetooth by remember {
        mutableStateOf(false)
    }

    var wifi by remember {
        mutableStateOf(false)
    }

    Column(
        modifier = Modifier
            .fillMaxSize()
            .background(Fondo)
    ) {

        TopBar(
            onMenu = onMenu
        )

        LazyColumn(
            modifier = Modifier
                .fillMaxSize()
                .padding(
                    start = 18.dp,
                    end = 18.dp,
                    top = 10.dp
                )
        ) {

            item {

                /* TARJETA CORPORAL */

                Card(
                    modifier = Modifier
                        .fillMaxWidth()
                        .border(
                            2.dp,
                            Cian,
                            RoundedCornerShape(23.dp)
                        ),
                    colors = CardDefaults.cardColors(
                        containerColor = Morado
                    ),
                    shape = RoundedCornerShape(23.dp)
                ) {

                    Column(
                        modifier = Modifier.padding(15.dp)
                    ) {

                        Row(
                            horizontalArrangement =
                                Arrangement.spacedBy(12.dp)
                        ) {

                            DashboardLegend(
                                Amarillo,
                                "Atención"
                            )

                            DashboardLegend(
                                Naranja,
                                "Esfuerzo elevado"
                            )

                            DashboardLegend(
                                Rojo,
                                "Riesgo elevado"
                            )
                        }

                        Spacer(
                            modifier = Modifier.height(8.dp)
                        )

                        Box(
                            modifier = Modifier
                                .fillMaxWidth()
                                .height(245.dp)
                        ) {

                            Icon(
                                Icons.Default.Person,
                                contentDescription = null,
                                tint = Color.LightGray,
                                modifier = Modifier
                                    .size(185.dp)
                                    .align(Alignment.Center)
                            )

                            /* 97% */

                            Column(
                                modifier = Modifier
                                    .align(
                                        Alignment.CenterEnd
                                    )
                            ) {

                                Text(
                                    "Nivel de",
                                    color = Blanco,
                                    fontSize = 12.sp
                                )

                                Text(
                                    "esfuerzo",
                                    color = Blanco,
                                    fontSize = 12.sp
                                )

                                Text(
                                    "97%",
                                    color = Amarillo,
                                    fontSize = 19.sp,
                                    fontWeight =
                                        FontWeight.Bold
                                )
                            }

                            /* 76% */

                            Column(
                                modifier = Modifier
                                    .align(
                                        Alignment.BottomStart
                                    )
                                    .padding(
                                        start = 45.dp
                                    )
                            ) {

                                Text(
                                    "Nivel de",
                                    color = Blanco,
                                    fontSize = 12.sp
                                )

                                Text(
                                    "esfuerzo",
                                    color = Blanco,
                                    fontSize = 12.sp
                                )

                                Text(
                                    "76%",
                                    color = Amarillo,
                                    fontSize = 19.sp,
                                    fontWeight =
                                        FontWeight.Bold
                                )
                            }

                            Text(
                                "TÚ",
                                color = Amarillo,
                                fontSize = 18.sp,
                                fontWeight = FontWeight.Bold,
                                modifier = Modifier
                                    .align(
                                        Alignment.BottomCenter
                                    )
                            )

                            Icon(
                                Icons.Default.Warning,
                                contentDescription = null,
                                tint = Amarillo,
                                modifier = Modifier
                                    .size(38.dp)
                                    .align(
                                        Alignment.BottomEnd
                                    )
                            )
                        }
                    }
                }

                Spacer(
                    modifier = Modifier.height(15.dp)
                )

                /* ESTADO CORPORAL */

                Card(
                    modifier = Modifier.fillMaxWidth(),
                    colors = CardDefaults.cardColors(
                        containerColor = Morado
                    ),
                    shape = RoundedCornerShape(23.dp)
                ) {

                    Column(
                        modifier = Modifier.padding(16.dp)
                    ) {

                        Text(
                            "Estado corporal actual",
                            color = Blanco,
                            fontSize = 19.sp,
                            fontWeight = FontWeight.Medium
                        )

                        Spacer(
                            modifier = Modifier.height(6.dp)
                        )

                        Row(
                            verticalAlignment =
                                Alignment.CenterVertically
                        ) {

                            Text(
                                "85%",
                                color = Amarillo,
                                fontSize = 24.sp,
                                fontWeight =
                                    FontWeight.Bold
                            )

                            Spacer(
                                modifier = Modifier.width(8.dp)
                            )

                            Text(
                                "Esfuerzo alto",
                                color = Blanco,
                                fontSize = 17.sp
                            )
                        }

                        Spacer(
                            modifier = Modifier.height(12.dp)
                        )

                        Row(
                            horizontalArrangement =
                                Arrangement.spacedBy(10.dp)
                        ) {

                            DashboardMetric(
                                modifier =
                                    Modifier.weight(1f),
                                title =
                                    "Frecuencia cardíaca",
                                value = "154 BPM"
                            )

                            DashboardMetric(
                                modifier =
                                    Modifier.weight(1f),
                                title =
                                    "SpO₂ (Oxígeno en sangre)",
                                value = "97%"
                            )
                        }

                        Spacer(
                            modifier = Modifier.height(10.dp)
                        )

                        Row(
                            horizontalArrangement =
                                Arrangement.spacedBy(10.dp)
                        ) {

                            DashboardMetric(
                                modifier =
                                    Modifier.weight(1f),
                                title = "Temperatura",
                                value = "36,8 °C"
                            )

                            DashboardMetric(
                                modifier =
                                    Modifier.weight(1f),
                                title =
                                    "Actividad muscular",
                                value = "Alta"
                            )
                        }

                        Spacer(
                            modifier = Modifier.height(10.dp)
                        )

                        DashboardMetric(
                            modifier =
                                Modifier.fillMaxWidth(),
                            title = "Movimiento",
                            value = "Normal"
                        )
                    }
                }

                Spacer(
                    modifier = Modifier.height(15.dp)
                )

                /* CONEXIONES */

                Card(
                    modifier = Modifier.fillMaxWidth(),
                    colors = CardDefaults.cardColors(
                        containerColor = Morado
                    ),
                    shape = RoundedCornerShape(20.dp)
                ) {

                    Column(
                        modifier = Modifier.padding(15.dp)
                    ) {

                        Text(
                            "Conecta la banda",
                            color = Blanco,
                            fontSize = 19.sp,
                            fontWeight = FontWeight.Bold
                        )

                        ConnectionLine(
                            icon = Icons.Default.Bluetooth,
                            title = "Bluetooth",
                            enabled = bluetooth,
                            onChange = {
                                bluetooth = it
                            }
                        )

                        ConnectionLine(
                            icon = Icons.Default.Wifi,
                            title = "Wi-Fi",
                            enabled = wifi,
                            onChange = {
                                wifi = it
                            }
                        )
                    }
                }

                Spacer(
                    modifier = Modifier.height(30.dp)
                )
            }
        }
    }
}

