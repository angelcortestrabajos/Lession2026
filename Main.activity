private enum class Screen {
    PROFILE_SETUP,
    DASHBOARD,
    MENU,
    PROFILE,
    LOGIN
}

// ============================================================
// COLORES
// ============================================================

private val Background = Color(0xFF291477)
private val Purple = Color(0xFF4930D2)
private val PurpleLight = Color(0xFF6045E8)
private val PurpleCard = Color(0xFF38218D)
private val PurpleDark = Color(0xFF21105F)

private val Neon = Color(0xFFD9FF00)
private val White = Color.White
private val Gray = Color(0xFFB9B0E8)

private val Green = Color(0xFF64E572)
private val Yellow = Color(0xFFFFD83D)
private val Red = Color(0xFFFF5757)
private val Blue = Color(0xFF59B7FF)


// ============================================================
// MAIN
// ============================================================

class MainActivity : ComponentActivity() {

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        enableEdgeToEdge()

        setContent {
            LessionApp()
        }
    }
}


// ============================================================
// APP
// ============================================================

@Composable
private fun LessionApp() {

    /*
     * AHORA EL PERFIL APARECE ANTES DEL DASHBOARD.
     */
    var screen by remember {
        mutableStateOf(Screen.PROFILE_SETUP)
    }

    var nombre by remember {
        mutableStateOf("")
    }

    var fechaNacimiento by remember {
        mutableStateOf("")
    }

    var peso by remember {
        mutableStateOf("")
    }

    var altura by remember {
        mutableStateOf("")
    }

    var sexo by remember {
        mutableStateOf("")
    }

    var tipoCuerpo by remember {
        mutableStateOf("")
    }

    var deporte by remember {
        mutableStateOf("")
    }

    var horasActividad by remember {
        mutableStateOf("")
    }

    var avatarUri by remember {
        mutableStateOf<Uri?>(null)
    }

    when (screen) {

        // ----------------------------------------------------
        // PERFIL INICIAL
        // ----------------------------------------------------

        Screen.PROFILE_SETUP -> {

            ProfileSetupScreen(

                nombre = nombre,
                fechaNacimiento = fechaNacimiento,
                peso = peso,
                altura = altura,
                sexo = sexo,
                tipoCuerpo = tipoCuerpo,
                deporte = deporte,
                horasActividad = horasActividad,
                avatarUri = avatarUri,

                onAvatarChange = {
                    avatarUri = it
                },

                onNombreChange = {
                    nombre = it
                },

                onFechaChange = {
                    fechaNacimiento = it
                },

                onPesoChange = {
                    peso = it
                },

                onAlturaChange = {
                    altura = it
                },

                onSexoChange = {
                    sexo = it
                },

                onTipoCuerpoChange = {
                    tipoCuerpo = it
                },

                onDeporteChange = {
                    deporte = it
                },

                onHorasChange = {
                    horasActividad = it
                },

                onContinue = {
                    screen = Screen.DASHBOARD
                }
            )
        }


        // ----------------------------------------------------
        // DASHBOARD
        // ----------------------------------------------------

        Screen.DASHBOARD -> {

            DashboardScreen(

                nombre = nombre,
                avatarUri = avatarUri,

                onMenu = {
                    screen = Screen.MENU
                }
            )
        }


        // ----------------------------------------------------
        // MENU
        // ----------------------------------------------------

        Screen.MENU -> {

            MenuScreen(

                nombre = nombre,
                avatarUri = avatarUri,

                onHome = {
                    screen = Screen.DASHBOARD
                },

                onProfile = {
                    screen = Screen.PROFILE
                },

                onConfiguration = {
                    screen = Screen.PROFILE
                },

                onBack = {
                    screen = Screen.DASHBOARD
                }
            )
        }


        // ----------------------------------------------------
        // PERFIL
        // ----------------------------------------------------

        Screen.PROFILE -> {

            ProfileScreen(

                nombre = nombre,
                fechaNacimiento = fechaNacimiento,
                peso = peso,
                altura = altura,
                sexo = sexo,
                tipoCuerpo = tipoCuerpo,
                deporte = deporte,
                horasActividad = horasActividad,
                avatarUri = avatarUri,

                onAvatarChange = {
                    avatarUri = it
                },

                onNombreChange = {
                    nombre = it
                },

                onFechaChange = {
                    fechaNacimiento = it
                },

                onPesoChange = {
                    peso = it
                },

                onAlturaChange = {
                    altura = it
                },

                onSexoChange = {
                    sexo = it
                },

                onTipoCuerpoChange = {
                    tipoCuerpo = it
                },

                onDeporteChange = {
                    deporte = it
                },

                onHorasChange = {
                    horasActividad = it
                },

                onSave = {
                    screen = Screen.DASHBOARD
                },

                onMenu = {
                    screen = Screen.MENU
                }
            )
        }


        // ----------------------------------------------------
        // LOGIN
        // ----------------------------------------------------

        Screen.LOGIN -> {

            LoginScreen(
                onLogin = {
                    screen = Screen.DASHBOARD
                },

                onBack = {
                    screen = Screen.PROFILE_SETUP
                }
            )
        }
    }
}


// ============================================================
// PERFIL INICIAL
// ============================================================

@Composable
private fun ProfileSetupScreen(

    nombre: String,
    fechaNacimiento: String,
    peso: String,
    altura: String,
    sexo: String,
    tipoCuerpo: String,
    deporte: String,
    horasActividad: String,
    avatarUri: Uri?,

    onAvatarChange: (Uri) -> Unit,
    onNombreChange: (String) -> Unit,
    onFechaChange: (String) -> Unit,
    onPesoChange: (String) -> Unit,
    onAlturaChange: (String) -> Unit,
    onSexoChange: (String) -> Unit,
    onTipoCuerpoChange: (String) -> Unit,
    onDeporteChange: (String) -> Unit,
    onHorasChange: (String) -> Unit,

    onContinue: () -> Unit
) {

    val launcher =
        rememberLauncherForActivityResult(
            ActivityResultContracts.GetContent()
        ) { uri ->

            if (uri != null) {
                onAvatarChange(uri)
            }
        }

    BaseScreen {

        Column(
            modifier = Modifier
                .fillMaxSize()
                .verticalScroll(
                    rememberScrollState()
                )
                .padding(
                    horizontal = 24.dp,
                    vertical = 20.dp
                ),
            horizontalAlignment = Alignment.CenterHorizontally
        ) {

            // LOGO REAL
            LessionLogo(
                modifier = Modifier
                    .height(90.dp)
                    .fillMaxWidth()
            )

            Spacer(
                modifier = Modifier.height(15.dp)
            )

            Text(
                text = "Configura tu perfil",
                color = White,
                fontSize = 29.sp,
                fontWeight = FontWeight.Bold
            )

            Spacer(
                modifier = Modifier.height(6.dp)
            )

            Text(
                text = "Cuéntanos un poco sobre ti",
                color = Gray,
                fontSize = 16.sp
            )

            Spacer(
                modifier = Modifier.height(25.dp)
            )

            // AVATAR
            AvatarSelector(
                avatarUri = avatarUri,
                onClick = {
                    launcher.launch("image/*")
                }
            )

            Spacer(
                modifier = Modifier.height(12.dp)
            )

            Text(
                text = "Agregar avatar",
                color = Neon,
                fontSize = 16.sp,
                fontWeight = FontWeight.Bold
            )

            Spacer(
                modifier = Modifier.height(25.dp)
            )

            BigTextField(
                value = nombre,
                onValueChange = onNombreChange,
                placeholder = "Nombre"
            )

            Spacer(Modifier.height(13.dp))

            BigTextField(
                value = fechaNacimiento,
                onValueChange = onFechaChange,
                placeholder = "Fecha de nacimiento"
            )

            Spacer(Modifier.height(13.dp))

            Row(
                modifier = Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.spacedBy(12.dp)
            ) {

                BigTextField(
                    value = peso,
                    onValueChange = onPesoChange,
                    placeholder = "Peso",
                    modifier = Modifier.weight(1f)
                )

                BigTextField(
                    value = altura,
                    onValueChange = onAlturaChange,
                    placeholder = "Altura",
                    modifier = Modifier.weight(1f)
                )
            }

            Spacer(Modifier.height(13.dp))

            Row(
                modifier = Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.spacedBy(12.dp)
            ) {

                BigTextField(
                    value = sexo,
                    onValueChange = onSexoChange,
                    placeholder = "Sexo",
                    modifier = Modifier.weight(1f)
                )

                BigTextField(
                    value = tipoCuerpo,
                    onValueChange = onTipoCuerpoChange,
                    placeholder = "Tipo de cuerpo",
                    modifier = Modifier.weight(1f)
                )
            }

            Spacer(
                modifier = Modifier.height(24.dp)
            )

            Text(
                text = "Opcionales",
                color = White,
                fontSize = 18.sp,
                fontWeight = FontWeight.Bold,
                modifier = Modifier.align(Alignment.Start)
            )

            Spacer(
                modifier = Modifier.height(12.dp)
            )

            BigTextField(
                value = deporte,
                onValueChange = onDeporteChange,
                placeholder = "Deporte que realizas"
            )

            Spacer(
                modifier = Modifier.height(13.dp)
            )

            BigTextField(
                value = horasActividad,
                onValueChange = onHorasChange,
                placeholder = "Horas semanales de actividad"
            )

            Spacer(
                modifier = Modifier.height(28.dp)
            )

            PrimaryButton(
                text = "CONTINUAR",
                modifier = Modifier.fillMaxWidth(),
                onClick = onContinue
            )

            Spacer(
                modifier = Modifier.height(20.dp)
            )
        }
    }
}


// ============================================================
// AVATAR
// ============================================================

@Composable
private fun AvatarSelector(
    avatarUri: Uri?,
    onClick: () -> Unit
) {

    Box(
        modifier = Modifier
            .size(120.dp)
            .clip(CircleShape)
            .background(PurpleLight)
            .clickable {
                onClick()
            },
        contentAlignment = Alignment.Center
    ) {

        if (avatarUri != null) {

            AsyncImage(
                model = avatarUri,
                contentDescription = "Avatar",
                modifier = Modifier
                    .fillMaxSize()
                    .clip(CircleShape),
                contentScale = ContentScale.Crop
            )

        } else {

            Icon(
                imageVector = Icons.Default.Person,
                contentDescription = null,
                tint = White,
                modifier = Modifier.size(65.dp)
            )
        }

        Box(
            modifier = Modifier
                .align(Alignment.BottomEnd)
                .size(38.dp)
                .clip(CircleShape)
                .background(Neon),
            contentAlignment = Alignment.Center
        ) {

            Icon(
                imageVector = Icons.Default.Add,
                contentDescription = "Agregar",
                tint = PurpleDark,
                modifier = Modifier.size(25.dp)
            )
        }
    }
}


// ============================================================
// DASHBOARD
// ============================================================

@Composable
private fun DashboardScreen(
    nombre: String,
    avatarUri: Uri?,
    onMenu: () -> Unit
) {

    BaseScreen {

        Column(
            modifier = Modifier.fillMaxSize()
        ) {

            // ------------------------------------------------
            // TOP BAR
            // ------------------------------------------------

            Row(
                modifier = Modifier
                    .fillMaxWidth()
                    .height(72.dp)
                    .background(Purple)
                    .padding(horizontal = 18.dp),
                verticalAlignment = Alignment.CenterVertically
            ) {

                LessionLogo(
                    modifier = Modifier.width(145.dp)
                )

                Spacer(
                    modifier = Modifier.weight(1f)
                )

                if (avatarUri != null) {

                    AsyncImage(
                        model = avatarUri,
                        contentDescription = "Avatar",
                        modifier = Modifier
                            .size(43.dp)
                            .clip(CircleShape),
                        contentScale = ContentScale.Crop
                    )

                    Spacer(
                        modifier = Modifier.width(12.dp)
                    )
                }

                IconButton(
                    onClick = onMenu
                ) {

                    Icon(
                        imageVector = Icons.Default.Menu,
                        contentDescription = "Menú",
                        tint = White,
                        modifier = Modifier.size(30.dp)
                    )
                }
            }

            // ------------------------------------------------
            // CONTENIDO
            // ------------------------------------------------

            Column(
                modifier = Modifier
                    .fillMaxSize()
                    .verticalScroll(
                        rememberScrollState()
                    )
                    .padding(20.dp)
            ) {

                Text(
                    text =
                        if (nombre.isBlank())
                            "Estado corporal"
                        else
                            "Hola, $nombre",

                    color = White,
                    fontSize = 27.sp,
                    fontWeight = FontWeight.Bold
                )

                Text(
                    text = "Tu rendimiento de hoy",
                    color = Gray,
                    fontSize = 16.sp
                )

                Spacer(
                    modifier = Modifier.height(20.dp)
                )

                // ------------------------------------------------
                // RENDIMIENTO
                // ------------------------------------------------

                PerformanceCard()

                Spacer(
                    modifier = Modifier.height(18.dp)
                )

                // ------------------------------------------------
                // FRECUENCIA CARDÍACA
                // ------------------------------------------------

                HeartRateCard()

                Spacer(
                    modifier = Modifier.height(18.dp)
                )

                // ------------------------------------------------
                // ESTADO CORPORAL
                // ------------------------------------------------

                BodyAnalysisCard()

                Spacer(
                    modifier = Modifier.height(18.dp)
                )

                // ------------------------------------------------
                // MÉTRICAS
                // ------------------------------------------------

                MetricsGrid()

                Spacer(
                    modifier = Modifier.height(25.dp)
                )
            }
        }
    }
}


