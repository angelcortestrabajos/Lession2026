// ============================================================
// OBTENER TEXTOS
// ============================================================

private fun getStrings(
    language: AppLanguage
): AppStrings {

    return when (language) {

        AppLanguage.ESPANOL ->
            spanishStrings()

        AppLanguage.ENGLISH ->
            englishStrings()

        AppLanguage.ESPANOL_LATINO ->
            latinSpanishStrings()
    }
}

// ============================================================
// MAIN ACTIVITY
// ============================================================

class MainActivity : ComponentActivity() {

    override fun onCreate(
        savedInstanceState: Bundle?
    ) {

        super.onCreate(
            savedInstanceState
        )

        enableEdgeToEdge()

        WindowCompat.setDecorFitsSystemWindows(
            window,
            false
        )

        WindowInsetsControllerCompat(
            window,
            window.decorView
        ).apply {

            hide(
                WindowInsetsCompat.Type.statusBars()
            )

            hide(
                WindowInsetsCompat.Type.navigationBars()
            )

            systemBarsBehavior =
                WindowInsetsControllerCompat
                    .BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE
        }

        setContent {
            LessionApp()
        }
    }
}

// ============================================================
// APP
// ============================================================

@Composable
private fun LessionApp() {

    val context =
        androidx.compose.ui.platform.LocalContext.current

    val coroutineScope = rememberCoroutineScope()

    val preferences = remember {

        context.getSharedPreferences(
            "lession_data",
            Context.MODE_PRIVATE
        )
    }

    var screen by remember {
        mutableStateOf(Screen.WELCOME)
    }

    var language by remember {

        mutableStateOf(
            when (
                preferences.getString(
                    "language",
                    "es"
                )
            ) {

                "en" ->
                    AppLanguage.ENGLISH

                "es-419" ->
                    AppLanguage.ESPANOL_LATINO

                else ->
                    AppLanguage.ESPANOL
            }
        )
    }

    val t = getStrings(language)

    var profile by remember {
        mutableStateOf<ProfileData?>(null)
    }

    LaunchedEffect(Unit) {
        val remoteProfile = obtenerPerfil()
        if (remoteProfile != null) {
            profile = ProfileData(
                name = "${remoteProfile.nombre} ${remoteProfile.apellido}",
                birthDate = remoteProfile.edad?.toString() ?: "",
                weight = remoteProfile.peso?.toString() ?: "",
                height = remoteProfile.altura?.toString() ?: "",
                gender = remoteProfile.genero ?: "",
                bodyType = remoteProfile.tipoCuerpo ?: "",
                sport = remoteProfile.objetivo ?: "",
                weeklyHours = remoteProfile.nivelActividad ?: "",
                avatar = remoteProfile.avatarUrl ?: ""
            )
        } else {
            profile = loadProfile(preferences)
        }
    }

    when (screen) {

        Screen.WELCOME -> {

            WelcomeScreen(
                t = t,

                onLogin = {
                    screen = Screen.LOGIN
                },

                onSignIn = {
                    screen = Screen.SIGNIN
                }
            )
        }

        Screen.LOGIN -> {

            LoginScreen(
                t = t,
                preferences = preferences,

                onBack = {
                    screen = Screen.WELCOME
                },

                onSuccess = { user ->

                    preferences.edit {
                        putString("current_user", user)
                    }

                    screen = Screen.PROFILE
                }
            )
        }

        Screen.SIGNIN -> {

            SignInScreen(
                t = t,

                onBack = {
                    screen = Screen.WELCOME
                },

                onCreated = {

                    profile = it

                    screen = Screen.PROFILE
                }
            )
        }

        Screen.PROFILE -> {

            profile?.let { currentProfile ->
                ProfileScreen(
                    t = t,
                    profile = currentProfile,

                    onProfileChanged = { updatedProfile ->

                        profile = updatedProfile

                        saveProfile(
                            preferences,
                            updatedProfile
                        )

                        // Update remote profile
                        val names = updatedProfile.name.split(" ", limit = 2)
                        val nombre = names.getOrNull(0) ?: ""
                        val apellido = names.getOrNull(1) ?: ""

                        coroutineScope.launch {
                            guardarPerfil(
                                nombre = nombre,
                                apellido = apellido,
                                edad = updatedProfile.birthDate.toIntOrNull(),
                                genero = updatedProfile.gender,
                                tipoCuerpo = updatedProfile.bodyType,
                                altura = updatedProfile.height.toDoubleOrNull(),
                                peso = updatedProfile.weight.toDoubleOrNull(),
                                objetivo = updatedProfile.sport,
                                nivelActividad = updatedProfile.weeklyHours
                            )
                        }
                    },

                    onContinue = {

                        saveProfile(
                            preferences,
                            currentProfile
                        )

                        screen = Screen.DASHBOARD
                    },

                    onMenu = {
                        screen = Screen.MENU
                    },

                    onLogout = {

                        preferences.edit {
                            remove("current_user")
                            putBoolean("savePassword", false)
                        }

                        coroutineScope.launch {
                            cerrarSesion()
                        }

                        screen = Screen.WELCOME
                    }
                )
            }
        }

        Screen.DASHBOARD -> {

            DashboardScreen(
                t = t,

                onMenu = {
                    screen = Screen.MENU
                }
            )
        }

        Screen.MENU -> {

            MenuScreen(
                t = t,

                onHome = {
                    screen = Screen.DASHBOARD
                },

                onProfile = {
                    screen = Screen.PROFILE
                },

                onSettings = {
                    screen = Screen.SETTINGS
                },

                onLogout = {

                    screen = Screen.WELCOME
                }
            )
        }

        Screen.SETTINGS -> {

            SettingsScreen(
                t = t,

                language = language,

                onLanguageChange = {

                    language = it

                    val code =
                        when (it) {

                            AppLanguage.ENGLISH ->
                                "en"

                            AppLanguage.ESPANOL_LATINO ->
                                "es-419"

                            AppLanguage.ESPANOL ->
                                "es"
                        }

                    preferences.edit {
                        putString(
                            "language",
                            code
                        )
                    }
                },

                onBack = {
                    screen = Screen.MENU
                }
            )
        }
    }
}

// ============================================================
// LOGO
// ============================================================

@Composable
private fun LessionLogo(
    modifier: Modifier = Modifier
) {

    Image(
        painter =
            painterResource(
                id = R.drawable.logo_lession
            ),

        contentDescription =
            "Logo Lession",

        modifier = modifier,

        contentScale =
            ContentScale.Fit
    )
}

// ============================================================
// WELCOME
// ============================================================

@Composable
private fun WelcomeScreen(
    t: AppStrings,
    onLogin: () -> Unit,
    onSignIn: () -> Unit
) {

    Box(
        modifier = Modifier
            .fillMaxSize()
            .background(Fondo)
    ) {

        Column(
            modifier = Modifier
                .fillMaxSize()
                .padding(
                    horizontal = 30.dp
                ),

            horizontalAlignment =
                Alignment.CenterHorizontally,

            verticalArrangement =
                Arrangement.Center
        ) {

            LessionLogo(
                modifier =
                    Modifier.size(190.dp)
            )

            Spacer(
                Modifier.height(12.dp)
            )

            Text(
                text = t.morePerformance,
                color = Amarillo,
                fontSize = 18.sp,
                fontWeight =
                    FontWeight.Bold
            )

            Text(
                text = t.lessImpact,
                color = Amarillo,
                fontSize = 18.sp,
                fontWeight =
                    FontWeight.Bold
            )

            Spacer(
                Modifier.height(35.dp)
            )

            SmallPurpleButton(
                t.login,
                onLogin
            )

            Spacer(
                Modifier.height(12.dp)
            )

            SmallPurpleButton(
                t.signIn,
                onSignIn
            )
        }
    }
}

// ============================================================
// LOGIN
// ============================================================

@Composable
private fun LoginScreen(
    t: AppStrings,
    preferences: android.content.SharedPreferences,
    onBack: () -> Unit,
    onSuccess: (String) -> Unit
) {

    val context =
        androidx.compose.ui.platform.LocalContext.current

    var username by remember {
        mutableStateOf("")
    }

    var password by remember {
        mutableStateOf("")
    }

    var savePassword by remember {

        mutableStateOf(
            preferences.getBoolean(
                "savePassword",
                false
            )
        )
    }

    var showPassword by remember {
        mutableStateOf(false)
    }

    LazyColumn(
        modifier = Modifier
            .fillMaxSize()
            .background(Fondo)
            .padding(
                horizontal = 28.dp
            ),

        horizontalAlignment =
            Alignment.CenterHorizontally
    ) {

        item {

            Spacer(
                Modifier.height(25.dp)
            )

            LessionLogo(
                Modifier.size(170.dp)
            )

            Spacer(
                Modifier.height(20.dp)
            )

            LessionField(
                username,
                { username = it },
                t.username
            )

            Spacer(
                Modifier.height(10.dp)
            )

            Box {

                LessionField(
                    password,
                    { password = it },
                    t.password,
                    password = !showPassword
                )

                IconButton(
                    onClick = {
                        showPassword =
                            !showPassword
                    },

                    modifier =
                        Modifier.align(
                            Alignment.CenterEnd
                        )
                ) {

                    Icon(
                        imageVector = if (showPassword)
                            Icons.Default.Visibility
                        else
                            Icons.Default.VisibilityOff,

                        contentDescription = null,

                        tint = Blanco
                    )
                }
            }

            Row(
                verticalAlignment =
                    Alignment.CenterVertically
            ) {

                Checkbox(
                    checked = savePassword,

                    onCheckedChange = {
                        savePassword = it
                    },

                    colors =
                        CheckboxDefaults.colors(
                            checkedColor =
                                Amarillo,

                            checkmarkColor =
                                Fondo
                        )
                )

                Text(
                    text = t.savePassword,
                    color = Blanco,
                    fontSize = 15.sp
                )
            }

            Spacer(
                Modifier.height(10.dp)
            )

                val coroutineScope = rememberCoroutineScope()

                SmallPurpleButton(
                    text = t.login
                ) {

                    if (
                        username.isBlank() ||
                        password.isBlank()
                    ) {

                        Toast.makeText(
                            context,
                            if (
                                languageForMessage(t)
                            )
                                "Completa todos los campos"
                            else
                                "Complete all fields",
                            Toast.LENGTH_SHORT
                        ).show()

                        return@SmallPurpleButton
                    }

                    coroutineScope.launch {
                        val result = iniciarSesion(username, password)
                        if (result.isSuccess) {
                            preferences.edit {
                                putBoolean(
                                    "savePassword",
                                    savePassword
                                )
                                if (savePassword) {
                                    putString("username", username)
                                    putString("password", password)
                                }
                            }
                            onSuccess(username)
                        } else {
                            Toast.makeText(
                                context,
                                if (languageForMessage(t))
                                    "Error al iniciar sesión: ${result.exceptionOrNull()?.message}"
                                else
                                    "Login error: ${result.exceptionOrNull()?.message}",
                                Toast.LENGTH_SHORT
                            ).show()
                        }
                    }
                }

            TextButton(
                onClick = onBack
            ) {

                Text(
                    text = t.back,
                    color = Amarillo,
                    fontSize = 16.sp
                )
            }
        }
    }
}

// ============================================================
// SIGN IN
// ============================================================

@Composable
private fun SignInScreen(
    t: AppStrings,
    onBack: () -> Unit,
    onCreated: (ProfileData) -> Unit
) {

    val context =
        androidx.compose.ui.platform.LocalContext.current

    var username by remember {
        mutableStateOf("")
    }

    var password by remember {
        mutableStateOf("")
    }

    var confirmPassword by remember {
        mutableStateOf("")
    }

    var name by remember {
        mutableStateOf("")
    }

    var birthDate by remember {
        mutableStateOf("")
    }

    var weight by remember {
        mutableStateOf("")
    }

    var height by remember {
        mutableStateOf("")
    }

    var gender by remember {
        mutableStateOf("")
    }

    var bodyType by remember {
        mutableStateOf("")
    }

    var sport by remember {
        mutableStateOf("")
    }

    var hours by remember {
        mutableStateOf("")
    }

    LazyColumn(
        modifier = Modifier
            .fillMaxSize()
            .background(Fondo)
            .padding(
                horizontal = 25.dp
            )
    ) {

        item {

            Spacer(
                Modifier.height(20.dp)
            )

            LessionLogo(
                Modifier
                    .fillMaxWidth()
                    .height(110.dp)
            )

            Text(
                text = t.configureProfile,
                color = Blanco,
                fontSize = 21.sp,
                fontWeight =
                    FontWeight.Bold
            )

            Spacer(
                Modifier.height(15.dp)
            )

            LessionField(
                username,
                { username = it },
                t.username
            )

            Spacer(
                Modifier.height(8.dp)
            )

            LessionField(
                password,
                { password = it },
                t.password,
                password = true
            )

            Spacer(
                Modifier.height(8.dp)
            )

            LessionField(
                confirmPassword,
                { confirmPassword = it },
                t.confirmPassword,
                password = true
            )

            Spacer(
                Modifier.height(15.dp)
            )

            ProfileHeader()

            Spacer(
                Modifier.height(13.dp)
            )

            LessionField(
                name,
                { name = it },
                t.name
            )

            Spacer(
                Modifier.height(8.dp)
            )

            LessionField(
                birthDate,
                { birthDate = it },
                t.birthDate
            )

            Spacer(
                Modifier.height(8.dp)
            )

            Row(
                horizontalArrangement =
                    Arrangement.spacedBy(8.dp)
            ) {

                LessionField(
                    weight,
                    { weight = it },
                    t.weight,
                    Modifier.weight(1f)
                )

                LessionField(
                    height,
                    { height = it },
                    t.height,
                    Modifier.weight(1f)
                )
            }

            Spacer(
                Modifier.height(8.dp)
            )

            DropdownField(
                gender,
                t.gender,

                listOf(
                    t.male,
                    t.female,
                    t.preferNot
                )
            ) {
                gender = it
            }

            Spacer(
                Modifier.height(8.dp)
            )

            DropdownField(
                bodyType,
                t.bodyType,

                listOf(
                    t.ectomorph,
                    t.endomorph,
                    t.mesomorph
                )
            ) {
                bodyType = it
            }

            Spacer(
                Modifier.height(10.dp)
            )

            Text(
                text = t.optional,
                color = Gris,
                fontSize = 14.sp
            )

            Spacer(
                Modifier.height(5.dp)
            )

            LessionField(
                sport,
                { sport = it },
                t.sport
            )

            Spacer(
                Modifier.height(8.dp)
            )

            LessionField(
                hours,
                { hours = it },
                t.weeklyHours
            )

            Spacer(
                Modifier.height(18.dp)
            )

            val coroutineScope = rememberCoroutineScope()

            SmallPurpleButton(
                t.save
            ) {

                if (
                    username.isBlank() ||
                    password.isBlank() ||
                    confirmPassword.isBlank() ||
                    name.isBlank() ||
                    birthDate.isBlank() ||
                    weight.isBlank() ||
                    height.isBlank() ||
                    gender.isBlank() ||
                    bodyType.isBlank() ||
                    sport.isBlank() ||
                    hours.isBlank()
                ) {

                    Toast.makeText(
                        context,
                        "Completa todos los campos",
                        Toast.LENGTH_SHORT
                    ).show()

                    return@SmallPurpleButton
                }

                if (
                    password != confirmPassword
                ) {

                    Toast.makeText(
                        context,
                        "Las contraseñas no coinciden",
                        Toast.LENGTH_SHORT
                    ).show()

                    return@SmallPurpleButton
                }

                if (
                    password.length < 6
                ) {

                    Toast.makeText(
                        context,
                        "La contraseña debe tener mínimo 6 caracteres",
                        Toast.LENGTH_SHORT
                    ).show()

                    return@SmallPurpleButton
                }

                coroutineScope.launch {
                    val names = name.split(" ", limit = 2)
                    val nombre = names.getOrNull(0) ?: ""
                    val apellido = names.getOrNull(1) ?: ""

                    val result = registrarUsuario(username, password, nombre, apellido)

                    if (result.isSuccess) {
                        val newProfile = ProfileData(
                            name,
                            birthDate,
                            weight,
                            height,
                            gender,
                            bodyType,
                            sport,
                            hours,
                            ""
                        )

                        guardarPerfil(
                            nombre = nombre,
                            apellido = apellido,
                            edad = birthDate.toIntOrNull(),
                            genero = gender,
                            tipoCuerpo = bodyType,
                            altura = height.toDoubleOrNull(),
                            peso = weight.toDoubleOrNull(),
                            objetivo = sport,
                            nivelActividad = hours
                        )

                        onCreated(newProfile)
                    } else {
                        Toast.makeText(
                            context,
                            "Error al registrar: ${result.exceptionOrNull()?.message}",
                            Toast.LENGTH_SHORT
                        ).show()
                    }
                }
            }

            TextButton(
                onClick = onBack
            ) {

                Text(
                    text = t.back,
                    color = Amarillo
                )
            }

            Spacer(
                Modifier.height(30.dp)
            )
        }
    }
}

// ============================================================
// DATOS PERFIL
// ============================================================

private data class ProfileData(
    val name: String = "",
    val birthDate: String = "",
    val weight: String = "",
    val height: String = "",
    val gender: String = "",
    val bodyType: String = "",
    val sport: String = "",
    val weeklyHours: String = "",
    val avatar: String = ""
)

// ============================================================
// PERFIL
// ============================================================

@Composable
private fun ProfileScreen(
    t: AppStrings,
    profile: ProfileData,
    onProfileChanged: (ProfileData) -> Unit,
    onContinue: () -> Unit,
    onMenu: () -> Unit,
    onLogout: () -> Unit
) {

    var gender by remember(profile.gender) {
        mutableStateOf(profile.gender)
    }

    var bodyType by remember(profile.bodyType) {
        mutableStateOf(profile.bodyType)
    }

    var avatar by remember(profile.avatar) {
        mutableStateOf(profile.avatar)
    }

    val picker =
        rememberLauncherForActivityResult(
            ActivityResultContracts.GetContent()
        ) { uri ->

            if (uri != null) {

                avatar = uri.toString()

                onProfileChanged(
                    profile.copy(
                        avatar = avatar
                    )
                )
            }
        }

    Column(
        Modifier
            .fillMaxSize()
            .background(Fondo)
    ) {

        TopBar(onMenu)

        LazyColumn(
            Modifier
                .fillMaxSize()
                .padding(
                    horizontal = 25.dp
                )
        ) {

            item {

                Spacer(
                    Modifier.height(15.dp)
                )

                ProfileHeader(
                    avatar = avatar,

                    onAvatarClick = {
                        picker.launch(
                            "image/*"
                        )
                    },

                    addAvatarText =
                        t.addAvatar
                )

                Spacer(
                    Modifier.height(15.dp)
                )

                ProfileReadOnly(
                    t.name,
                    profile.name
                )

                ProfileReadOnly(
                    t.birthDate,
                    profile.birthDate
                )

                ProfileReadOnly(
                    t.weight,
                    profile.weight
                )

                ProfileReadOnly(
                    t.height,
                    profile.height
                )

                Spacer(
                    Modifier.height(7.dp)
                )

                DropdownField(
                    gender,
                    t.gender,

                    listOf(
                        t.male,
                        t.female,
                        t.preferNot
                    )
                ) {

                    gender = it

                    onProfileChanged(
                        profile.copy(
                            gender = it
                        )
                    )
                }

                Spacer(
                    Modifier.height(8.dp)
                )

                DropdownField(
                    bodyType,
                    t.bodyType,

                    listOf(
                        t.ectomorph,
                        t.endomorph,
                        t.mesomorph
                    )
                ) {

                    bodyType = it

                    onProfileChanged(
                        profile.copy(
                            bodyType = it
                        )
                    )
                }

                Spacer(
                    Modifier.height(8.dp)
                )

                ProfileReadOnly(
                    t.sport,
                    profile.sport
                )

                ProfileReadOnly(
                    t.weeklyHours,
                    profile.weeklyHours
                )

                Spacer(
                    Modifier.height(18.dp)
                )

                SmallPurpleButton(
                    t.save
                ) {

                    onProfileChanged(
                        profile.copy(
                            gender = gender,
                            bodyType = bodyType,
                            avatar = avatar
                        )
                    )

                    onContinue()
                }

                Spacer(
                    Modifier.height(10.dp)
                )

                OutlinedButton(
                    onClick = onLogout,

                    Modifier
                        .fillMaxWidth()
                        .height(48.dp)
                ) {

                    Icon(
                        imageVector = Icons.Default.PowerSettingsNew,
                        contentDescription = null,
                        tint = Rojo
                    )

                    Spacer(
                        Modifier.width(7.dp)
                    )

                Text(
                    text = t.logout,
                    color = Rojo,
                    fontSize = 16.sp
                )
                }

                Spacer(
                    Modifier.height(30.dp)
                )
            }
        }
    }
}

