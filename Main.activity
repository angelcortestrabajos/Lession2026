// ============================================================
// CONFIGURACIÓN COMPLETA
// ============================================================

@Composable
private fun SettingsScreen(
    t: AppStrings,
    language: AppLanguage,
    onLanguageChange: (AppLanguage) -> Unit,
    onBack: () -> Unit
) {

    var bluetooth by remember {
        mutableStateOf(false)
    }

    var wifi by remember {
        mutableStateOf(false)
    }

    var effortAlerts by remember {
        mutableStateOf(true)
    }

    var heartAlerts by remember {
        mutableStateOf(true)
    }

    var oxygenAlerts by remember {
        mutableStateOf(true)
    }

    var temperatureAlerts by remember {
        mutableStateOf(true)
    }

    var vibration by remember {
        mutableStateOf(true)
    }

    var sound by remember {
        mutableStateOf(false)
    }

    var automaticUpdate by remember {
        mutableStateOf(true)
    }

    var updateFrequency by remember {
        mutableStateOf(t.seconds15)
    }

    var textSize by remember {
        mutableStateOf(t.normalSize)
    }

    var animations by remember {
        mutableStateOf(true)
    }

    var percentages by remember {
        mutableStateOf(true)
    }

    var heartRate by remember {
        mutableStateOf(true)
    }

    var oxygen by remember {
        mutableStateOf(true)
    }

    var temperature by remember {
        mutableStateOf(true)
    }

    var movement by remember {
        mutableStateOf(true)
    }

    var muscle by remember {
        mutableStateOf(true)
    }

    var effort by remember {
        mutableStateOf(true)
    }

    Column(
        Modifier
            .fillMaxSize()
            .background(Fondo)
    ) {

        Row(
            Modifier
                .fillMaxWidth()
                .height(62.dp)
                .background(MoradoClaro)
                .padding(
                    horizontal = 7.dp
                ),

            verticalAlignment =
                Alignment.CenterVertically
        ) {

            IconButton(
                onClick = onBack
            ) {

                Icon(
                    imageVector = Icons.AutoMirrored.Filled.ArrowBack,
                    contentDescription = null,
                    tint = Blanco
                )
            }

            LessionLogo(
                Modifier
                    .width(115.dp)
                    .height(52.dp)
            )
        }

        LazyColumn(
            Modifier
                .fillMaxSize()
                .padding(
                    horizontal = 17.dp
                )
        ) {

            item {

                // --------------------------------------------
                // ENTRENAMIENTO
                // --------------------------------------------

                SettingsTitle(
                    "🏃",
                    t.trainingPreferences
                )

                SettingsCard {

                    SettingsRow(
                        t.mainSport,
                        "Perfil"
                    )

                    SettingsRow(
                        t.trainingLevel,
                        t.intermediate
                    )

                    SettingsRow(
                        t.objective,
                        t.performance
                    )

                    SettingsRow(
                        t.weeklyHours,
                        "Perfil"
                    )

                    SettingsRow(
                        t.defaultIntensity,
                        t.high
                    )
                }

                // --------------------------------------------
                // ALERTAS
                // --------------------------------------------

                SettingsTitle(
                    "🩺",
                    t.alertsSecurity
                )

                SettingsCard {

                    SettingsSwitch(
                        t.effortAlerts,
                        effortAlerts
                    ) {
                        effortAlerts = it
                    }

                    SettingsSwitch(
                        t.heartAlerts,
                        heartAlerts
                    ) {
                        heartAlerts = it
                    }

                    SettingsSwitch(
                        t.oxygenAlerts,
                        oxygenAlerts
                    ) {
                        oxygenAlerts = it
                    }

                    SettingsSwitch(
                        t.temperatureAlerts,
                        temperatureAlerts
                    ) {
                        temperatureAlerts = it
                    }

                    SettingsSwitch(
                        t.vibration,
                        vibration
                    ) {
                        vibration = it
                    }

                    SettingsSwitch(
                        t.alertSound,
                        sound
                    ) {
                        sound = it
                    }
                }

                // --------------------------------------------
                // BANDA
                // --------------------------------------------

                SettingsTitle(
                    "📡",
                    t.bandConnection
                )

                SettingsCard {

                    ConnectionSetting(
                        icon = Icons.Default.Bluetooth,
                        title = t.bluetooth,
                        status = if (bluetooth)
                            t.connected
                        else
                            t.disconnected,
                        enabled = bluetooth
                    ) {
                        bluetooth = it
                    }

                    ConnectionSetting(
                        icon = Icons.Default.Wifi,
                        title = t.wifi,
                        status = if (wifi)
                            t.connected
                        else
                            t.disconnected,
                        enabled = wifi
                    ) {
                        wifi = it
                    }

                    SettingsButton(
                        t.searchBand
                    )

                    SettingsButton(
                        t.syncNow
                    )

                    SettingsRow(
                        t.bandName,
                        "LESSION Band 01"
                    )

                    SettingsRow(
                        t.battery,
                        "82%"
                    )

                    SettingsRow(
                        t.lastSync,
                        "2 min"
                    )

                    SettingsButton(
                        t.unpairBand,
                        true
                    )
                }

                // --------------------------------------------
                // DATOS
                // --------------------------------------------

                SettingsTitle(
                    "📊",
                    t.dataMeasurements
                )

                SettingsCard {

                    SettingsSwitch(
                        t.heartRate,
                        heartRate
                    ) {
                        heartRate = it
                    }

                    SettingsSwitch(
                        t.oxygen,
                        oxygen
                    ) {
                        oxygen = it
                    }

                    SettingsSwitch(
                        t.temperature,
                        temperature
                    ) {
                        temperature = it
                    }

                    SettingsSwitch(
                        t.movement,
                        movement
                    ) {
                        movement = it
                    }

                    SettingsSwitch(
                        t.muscleActivity,
                        muscle
                    ) {
                        muscle = it
                    }

                    SettingsSwitch(
                        t.effortLevel,
                        effort
                    ) {
                        effort = it
                    }

                    SettingsSwitch(
                        t.automaticUpdate,
                        automaticUpdate
                    ) {
                        automaticUpdate = it
                    }

                    SettingsDropdown(
                        t.updateFrequency,
                        updateFrequency,

                        listOf(
                            t.seconds5,
                            t.seconds15,
                            t.seconds30,
                            t.manual
                        )
                    ) {
                        updateFrequency = it
                    }
                }

                // --------------------------------------------
                // APARIENCIA
                // --------------------------------------------

                SettingsTitle(
                    "🎨",
                    t.appearance
                )

                SettingsCard {

                    SettingsRow(
                        t.theme,
                        t.lessionTheme
                    )

                    SettingsDropdown(
                        t.textSize,
                        textSize,

                        listOf(
                            t.normalSize,
                            t.largeSize
                        )
                    ) {
                        textSize = it
                    }

                    SettingsSwitch(
                        t.animations,
                        animations
                    ) {
                        animations = it
                    }

                    SettingsSwitch(
                        t.percentages,
                        percentages
                    ) {
                        percentages = it
                    }
                }

                // --------------------------------------------
                // IDIOMA
                // --------------------------------------------

                SettingsTitle(
                    "🌎",
                    t.language
                )

                SettingsCard {

                    LanguageSelector(
                        t = t,
                        selected = language,
                        onSelected =
                            onLanguageChange
                    )
                }

                // --------------------------------------------
                // PRIVACIDAD
                // --------------------------------------------

                SettingsTitle(
                    "🔐",
                    t.privacy
                )

                SettingsCard {

                    SettingsSwitch(
                        t.personalData,
                        true
                    ) {}

                    SettingsSwitch(
                        t.dataStorage,
                        true
                    ) {}

                    SettingsButton(
                        t.deleteHistory,
                        true
                    )

                    SettingsButton(
                        t.deleteAllData,
                        true
                    )
                }

                // --------------------------------------------
                // ACERCA DE
                // --------------------------------------------

                SettingsTitle(
                    "ℹ️",
                    t.aboutLession
                )

                SettingsCard {

                    Text(
                        text = "LESSION",
                        color = Amarillo,
                        fontSize = 25.sp,
                        fontWeight =
                            FontWeight.Bold
                    )

                    Spacer(
                        Modifier.height(5.dp)
                    )

                    Text(
                        t.slogan,
                        color = Blanco,
                        fontSize = 15.sp
                    )

                    Spacer(
                        Modifier.height(8.dp)
                    )

                    Text(
                        t.version,
                        color = Gris,
                        fontSize = 14.sp
                    )

                    SettingsButton(
                        t.support
                    )

                    SettingsButton(
                        t.terms
                    )

                    SettingsButton(
                        t.privacyPolicy
                    )
                }

                Spacer(
                    Modifier.height(35.dp)
                )
            }
        }
    }
}

// ============================================================
// SELECTOR DE IDIOMA
// ============================================================

@Composable
private fun LanguageSelector(
    t: AppStrings,
    selected: AppLanguage,
    onSelected: (AppLanguage) -> Unit
) {

    var expanded by remember {
        mutableStateOf(false)
    }

    val currentText =
        when (selected) {

            AppLanguage.ESPANOL ->
                t.spanish

            AppLanguage.ENGLISH ->
                t.english

            AppLanguage.ESPANOL_LATINO ->
                t.latinSpanish
        }

    Box(
        Modifier.fillMaxWidth()
    ) {

        Row(
            Modifier
                .fillMaxWidth()
                .clickable {
                    expanded = true
                }
                .padding(
                    vertical = 9.dp
                ),

            verticalAlignment =
                Alignment.CenterVertically
        ) {

            Text(
                text = t.language,
                color = Blanco,
                fontSize = 17.sp,

                modifier = Modifier.weight(1f)
            )

            Text(
                currentText,
                color = Amarillo,
                fontSize = 16.sp
            )

            Icon(
                imageVector = Icons.Default.ArrowDropDown,
                contentDescription = null,
                tint = Blanco
            )
        }

        DropdownMenu(
            expanded = expanded,

            onDismissRequest = {
                expanded = false
            },

            modifier =
                Modifier.background(
                    Morado
                )
        ) {

            DropdownMenuItem(

                text = {
                    Text(
                        t.spanish,
                        color = Blanco,
                        fontSize = 16.sp
                    )
                },

                onClick = {

                    onSelected(
                        AppLanguage.ESPANOL
                    )

                    expanded = false
                }
            )

            DropdownMenuItem(

                text = {
                    Text(
                        t.english,
                        color = Blanco,
                        fontSize = 16.sp
                    )
                },

                onClick = {

                    onSelected(
                        AppLanguage.ENGLISH
                    )

                    expanded = false
                }
            )

            DropdownMenuItem(

                text = {
                    Text(
                        t.latinSpanish,
                        color = Blanco,
                        fontSize = 16.sp
                    )
                },

                onClick = {

                    onSelected(
                        AppLanguage.ESPANOL_LATINO
                    )

                    expanded = false
                }
            )
        }
    }
}

