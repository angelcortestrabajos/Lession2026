@Composable
private fun MenuScreen(
    onHome: () -> Unit,
    onProfile: () -> Unit,
    onLogout: () -> Unit
) {

    Column(
        modifier = Modifier
            .fillMaxSize()
            .background(Fondo)
    ) {

        TopBar(
            onMenu = {}
        )

        Spacer(
            modifier = Modifier.height(15.dp)
        )

        MenuItem(
            "Inicio",
            Icons.Default.Home,
            onHome
        )

        MenuItem(
            "Perfil",
            Icons.Default.Person,
            onProfile
        )

        MenuItem(
            "Configuración",
            Icons.Default.Settings,
            {}
        )

        MenuItem(
            "Sobre nosotros",
            Icons.Default.Info,
            {}
        )

        Spacer(
            modifier = Modifier.weight(1f)
        )

        MenuItem(
            "Cerrar sesión",
            Icons.Default.PowerSettingsNew,
            onLogout
        )

        Spacer(
            modifier = Modifier.height(25.dp)
        )
    }
}

/* ============================================================
   COMPONENTES VISUALES
   ============================================================ */

@Composable
private fun TopBar(
    onMenu: () -> Unit
) {

    Row(
        modifier = Modifier
            .fillMaxWidth()
            .height(62.dp)
            .background(MoradoClaro)
            .padding(horizontal = 10.dp),
        verticalAlignment = Alignment.CenterVertically
    ) {

        LessionLogo(
            modifier = Modifier.size(45.dp)
        )

        Spacer(
            modifier = Modifier.width(5.dp)
        )

        Text(
            "LESSION",
            color = Amarillo,
            fontSize = 20.sp,
            fontWeight = FontWeight.ExtraBold
        )

        Spacer(
            modifier = Modifier.weight(1f)
        )

        IconButton(
            onClick = onMenu
        ) {

            Icon(
                Icons.Default.Menu,
                contentDescription = "Menu",
                tint = Blanco,
                modifier = Modifier.size(30.dp)
            )
        }
    }
}

@Composable
private fun SmallPurpleButton(
    text: String,
    onClick: () -> Unit
) {

    Button(
        onClick = onClick,
        modifier = Modifier
            .width(145.dp)
            .height(45.dp),
        shape = RoundedCornerShape(25.dp),
        colors = ButtonDefaults.buttonColors(
            containerColor = MoradoClaro,
            contentColor = Blanco
        )
    ) {

        Text(
            text = text,
            fontSize = 15.sp,
            fontWeight = FontWeight.Bold
        )
    }
}

@Composable
private fun LessionField(
    value: String,
    onValueChange: (String) -> Unit,
    hint: String,
    modifier: Modifier = Modifier,
    password: Boolean = false
) {

    OutlinedTextField(
        value = value,
        onValueChange = onValueChange,
        modifier = modifier
            .fillMaxWidth()
            .height(55.dp),
        singleLine = true,
        placeholder = {
            Text(
                hint,
                color = Gris,
                fontSize = 14.sp
            )
        },
        textStyle = LocalTextStyle.current.copy(
            color = Blanco,
            fontSize = 16.sp
        ),
        visualTransformation =
            if (password)
                PasswordVisualTransformation()
            else
                VisualTransformation.None,
        colors = OutlinedTextFieldDefaults.colors(
            focusedBorderColor = Cian,
            unfocusedBorderColor = MoradoClaro,
            focusedTextColor = Blanco,
            unfocusedTextColor = Blanco,
            cursorColor = Amarillo
        ),
        shape = RoundedCornerShape(20.dp)
    )
}

@Composable
private fun DropdownField(
    value: String,
    hint: String,
    options: List<String>,
    onSelected: (String) -> Unit
) {

    var expanded by remember {
        mutableStateOf(false)
    }

    Box(
        modifier = Modifier.fillMaxWidth()
    ) {

        OutlinedTextField(
            value = value,
            onValueChange = {},
            modifier = Modifier
                .fillMaxWidth()
                .height(55.dp),
            readOnly = true,
            placeholder = {
                Text(
                    hint,
                    color = Gris,
                    fontSize = 14.sp
                )
            },
            trailingIcon = {
                Icon(
                    Icons.Default.ArrowDropDown,
                    contentDescription = null,
                    tint = Blanco
                )
            },
            textStyle = LocalTextStyle.current.copy(
                color = Blanco,
                fontSize = 16.sp
            ),
            colors = OutlinedTextFieldDefaults.colors(
                focusedBorderColor = Cian,
                unfocusedBorderColor = MoradoClaro
            ),
            shape = RoundedCornerShape(20.dp)
        )

        Box(
            modifier = Modifier
                .matchParentSize()
                .clickable {
                    expanded = true
                }
        )

        DropdownMenu(
            expanded = expanded,
            onDismissRequest = {
                expanded = false
            },
            modifier = Modifier.background(Morado)
        ) {

            options.forEach { option ->

                DropdownMenuItem(
                    text = {
                        Text(
                            option,
                            color = Blanco,
                            fontSize = 16.sp
                        )
                    },
                    onClick = {

                        onSelected(option)
                        expanded = false
                    }
                )
            }
        }
    }
}

@Composable
private fun ProfileHeader(
    avatar: String = "",
    onAvatarClick: (() -> Unit)? = null
) {

    Column(
        modifier = Modifier.fillMaxWidth(),
        horizontalAlignment = Alignment.CenterHorizontally
    ) {

        Box(
            modifier = Modifier
                .size(92.dp)
                .clip(CircleShape)
                .background(MoradoClaro)
                .border(
                    2.dp,
                    Amarillo,
                    CircleShape
                )
                .clickable(
                    enabled = onAvatarClick != null
                ) {
                    onAvatarClick?.invoke()
                },
            contentAlignment = Alignment.Center
        ) {

            if (avatar.isBlank()) {

                Icon(
                    Icons.Default.Person,
                    contentDescription = null,
                    tint = Blanco,
                    modifier = Modifier.size(55.dp)
                )

            } else {

                // Se mantiene el avatar dentro del mismo círculo
                // del diseño original.
                Icon(
                    Icons.Default.Person,
                    contentDescription = null,
                    tint = Amarillo,
                    modifier = Modifier.size(55.dp)
                )
            }
        }

        if (onAvatarClick != null) {

            Spacer(
                modifier = Modifier.height(6.dp)
            )

            Text(
                "Agregar avatar",
                color = Amarillo,
                fontSize = 14.sp
            )
        }
    }
}

@Composable
private fun ProfileReadOnly(
    title: String,
    value: String
) {

    Column(
        modifier = Modifier
            .fillMaxWidth()
            .padding(vertical = 4.dp)
    ) {

        Text(
            title,
            color = Gris,
            fontSize = 13.sp
        )

        Text(
            value,
            color = Blanco,
            fontSize = 17.sp,
            fontWeight = FontWeight.Medium
        )
    }
}

@Composable
private fun DashboardLegend(
    color: Color,
    text: String
) {

    Row(
        verticalAlignment = Alignment.CenterVertically
    ) {

        Box(
            modifier = Modifier
                .size(11.dp)
                .clip(CircleShape)
                .background(color)
        )

        Spacer(
            modifier = Modifier.width(5.dp)
        )

        Text(
            text,
            color = Blanco,
            fontSize = 11.sp
        )
    }
}

@Composable
private fun DashboardMetric(
    modifier: Modifier,
    title: String,
    value: String
) {

    Card(
        modifier = modifier,
        colors = CardDefaults.cardColors(
            containerColor = MoradoClaro
        ),
        shape = RoundedCornerShape(14.dp)
    ) {

        Column(
            modifier = Modifier.padding(11.dp)
        ) {

            Text(
                title,
                color = Blanco,
                fontSize = 12.sp
            )

            Spacer(
                modifier = Modifier.height(5.dp)
            )

            Text(
                value,
                color = Amarillo,
                fontSize = 21.sp,
                fontWeight = FontWeight.Bold
            )
        }
    }
}

@Composable
private fun ConnectionLine(
    icon: ImageVector,
    title: String,
    enabled: Boolean,
    onChange: (Boolean) -> Unit
) {

    Row(
        modifier = Modifier
            .fillMaxWidth()
            .padding(vertical = 4.dp),
        verticalAlignment = Alignment.CenterVertically
    ) {

        Icon(
            icon,
            contentDescription = null,
            tint = if (enabled) Amarillo else Blanco,
            modifier = Modifier.size(27.dp)
        )

        Spacer(
            modifier = Modifier.width(8.dp)
        )

        Text(
            title,
            color = Blanco,
            fontSize = 15.sp,
            modifier = Modifier.weight(1f)
        )

        Switch(
            checked = enabled,
            onCheckedChange = onChange
        )
    }
}

@Composable
private fun MenuItem(
    text: String,
    icon: ImageVector,
    onClick: () -> Unit
) {

    Row(
        modifier = Modifier
            .fillMaxWidth()
            .clickable {
                onClick()
            }
            .padding(
                horizontal = 25.dp,
                vertical = 17.dp
            ),
        verticalAlignment = Alignment.CenterVertically
    ) {

        Icon(
            icon,
            contentDescription = null,
            tint = Amarillo,
            modifier = Modifier.size(27.dp)
        )

        Spacer(
            modifier = Modifier.width(17.dp)
        )

        Text(
            text,
            color = Blanco,
            fontSize = 18.sp
        )
    }
}

/* ============================================================
   DATOS
   ============================================================ */

private fun saveProfile(
    context: Context,
    profile: ProfileData
) {
    val prefs = context.getSharedPreferences("lession_profile", Context.MODE_PRIVATE)
    prefs.edit().apply {
        putString("name", profile.name)
        putString("birthDate", profile.birthDate)
        putString("weight", profile.weight)
        putString("height", profile.height)
        putString("gender", profile.gender)
        putString("bodyType", profile.bodyType)
        putString("sport", profile.sport)
        putString("weeklyHours", profile.weeklyHours)
        putString("avatar", profile.avatar)
        apply()
    }
}

private fun loadProfile(context: Context): ProfileData {
    val prefs = context.getSharedPreferences("lession_profile", Context.MODE_PRIVATE)
    return ProfileData(
        name = prefs.getString("name", "") ?: "",
        birthDate = prefs.getString("birthDate", "") ?: "",
        weight = prefs.getString("weight", "") ?: "",
        height = prefs.getString("height", "") ?: "",
        gender = prefs.getString("gender", "") ?: "",
        bodyType = prefs.getString("bodyType", "") ?: "",
        sport = prefs.getString("sport", "") ?: "",
        weeklyHours = prefs.getString("weeklyHours", "") ?: "",
        avatar = prefs.getString("avatar", "") ?: ""
    )
}
