@Composable
private fun LessionLogo(
    modifier: Modifier = Modifier
) {
    Icon(
        imageVector = Icons.Default.Bolt,
        contentDescription = "Lession Logo",
        modifier = modifier,
        tint = Amarillo
    )
}

/* ============================================================
   WELCOME
   ============================================================ */

@Composable
private fun WelcomeScreen(
    onLogin: () -> Unit,
    onSignIn: () -> Unit
) {

    Box(
        modifier = Modifier
            .fillMaxSize()
            .background(Fondo)
    ) {

        Column(
            modifier = Modifier
                .fillMaxSize()
                .padding(horizontal = 40.dp),
            horizontalAlignment = Alignment.CenterHorizontally,
            verticalArrangement = Arrangement.Center
        ) {

            LessionLogo(
                modifier = Modifier.size(175.dp)
            )

            Spacer(
                modifier = Modifier.height(18.dp)
            )

            Text(
                text = "LESSION",
                color = Amarillo,
                fontSize = 31.sp,
                fontWeight = FontWeight.ExtraBold
            )

            Spacer(
                modifier = Modifier.height(4.dp)
            )

            Text(
                text = "MÁS RENDIMIENTO",
                color = Amarillo,
                fontSize = 17.sp,
                fontWeight = FontWeight.Bold
            )

            Text(
                text = "MENOS IMPACTO",
                color = Amarillo,
                fontSize = 17.sp,
                fontWeight = FontWeight.Bold
            )

            Spacer(
                modifier = Modifier.height(45.dp)
            )

            SmallPurpleButton(
                text = "Log In",
                onClick = onLogin
            )

            Spacer(
