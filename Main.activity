// ============================================================
// GAUGE
// ============================================================

@Composable
private fun PerformanceGauge(
    modifier: Modifier,
    percentage: Float
) {

    Box(
        modifier = modifier,
        contentAlignment = Alignment.Center
    ) {

        Canvas(
            modifier = Modifier.fillMaxSize()
        ) {

            val stroke = 18f

            drawArc(
                color = PurpleDark,
                startAngle = 140f,
                sweepAngle = 260f,
                useCenter = false,
                style = Stroke(
                    width = stroke,
                    cap = StrokeCap.Round
                )
            )

            drawArc(
                color = Neon,
                startAngle = 140f,
                sweepAngle = 260f * percentage,
                useCenter = false,
                style = Stroke(
                    width = stroke,
                    cap = StrokeCap.Round
                )
            )
        }

        Text(
            text = "${(percentage * 100).toInt()}%",
            color = White,
            fontSize = 27.sp,
            fontWeight = FontWeight.Bold
        )
    }
}


